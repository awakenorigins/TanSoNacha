---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Chứng Duyên · Tần Số Nacha"><main class="min-h-screen bg-ink text-parchment p-5"><section class="max-w-3xl mx-auto"><h1 class="font-display text-4xl mt-12">Chứng Duyên</h1><p class="opacity-70 my-3">Tạo Mời Duyên và hồi đáp những lời thỉnh đang chờ.</p><button id="create" class="btn-primary">Tạo Mời Duyên</button><p id="msg" class="my-3 text-bronze-light"></p><h2 class="text-2xl mt-8">Mời Duyên của bạn</h2><div id="codes" class="grid gap-3 mt-3"></div><h2 class="text-2xl mt-8">Lời thỉnh</h2><div id="requests" class="grid gap-3 mt-3"></div></section></main><script>const token=localStorage.getItem('pp-token')||'',h={'X-PP-Token':token},esc=(s:string)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));async function load(){if(!token){location.href='/vao-coi';return}const [a,b]=await Promise.all([fetch('/pp-api/invites',{headers:h}),fetch('/pp-api/invite/requests',{headers:h})]),x=await a.json(),y=await b.json();document.querySelector('#codes')!.innerHTML=(x.invites||[]).map((i:any)=>`<article class="p-4 border border-bronze/30 rounded-xl"><b>${esc(i.status)}</b><input class="w-full bg-transparent text-xs mt-2" readonly value="${esc(i.url)}"><button data-copy="${esc(i.url)}" class="underline text-sm">Sao chép liên kết</button></article>`).join('')||'<p>Chưa có mã.</p>';document.querySelector('#requests')!.innerHTML=(y.requests||[]).map((q:any)=>`<article class="p-4 border border-bronze/30 rounded-xl"><b>${esc(q.phapdanh)}</b> · ${esc(q.status)} ${q.status==='pending'?`<div><button data-id="${q.id}" data-d="accept" class="btn-primary mr-2">Chứng nhận</button><button data-id="${q.id}" data-d="reject" class="underline">Khép lời thỉnh</button></div>`:''}</article>`).join('')||'<p>Chưa có lời thỉnh.</p>'}document.querySelector('#create')!.addEventListener('click',async()=>{const r=await fetch('/pp-api/invites',{method:'POST',headers:h}),d=await r.json();document.querySelector('#msg')!.textContent=d.error||'Đã tạo Mời Duyên';load()});document.addEventListener('click',async(e:any)=>{const b=e.target.closest('[data-copy]');if(b)navigator.clipboard.writeText(b.dataset.copy);const d=e.target.closest('[data-d]');if(d){await fetch('/pp-api/invite/decide',{method:'POST',headers:{...h,'Content-Type':'application/json'},body:JSON.stringify({id:Number(d.dataset.id),decision:d.dataset.d})});load()}});load();</script></BaseLayout>
