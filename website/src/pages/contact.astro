---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Liên Lạc — Tần Số Nacha 聯絡">

  <!-- HERO -->
  <section class="relative py-24 md:py-32 bg-ink overflow-hidden">
    <img src="/images/art/img-27-wide.jpg" alt="Liên lạc thủ các" class="tkc-hero-art absolute inset-0 w-full h-full object-cover opacity-52" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/90 via-ink/58 to-ink/98"></div>
    <div class="absolute inset-0" style="background: radial-gradient(circle at 70% 50%, rgba(139,111,46,0.25) 0%, transparent 60%);"></div>
    <div class="container-content relative text-center">
      <p class="font-brush text-bronze-light text-2xl tracking-widest mb-4" data-animate="fade-in">聯 絡</p>
      <h1 class="font-display text-5xl md:text-6xl text-parchment mb-4" data-animate="fade-up">Liên Lạc Thủ Các</h1>
      <p class="font-accent italic text-parchment/70 text-lg max-w-2xl mx-auto" data-animate="fade-up">
        Có chuyện cần hỏi, có sách muốn dâng, hay chỉ là vài lời gió thoảng — thư từ luôn được chào đón.
     </p>
   </div>
 </section>

  <!-- INFO -->
  <section class="section-padding bg-parchment">
    <div class="container-content max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12">

        <!-- LEFT -->
        <div class="space-y-6" data-animate="fade-up">
          <div>
            <p class="font-brush text-bronze text-2xl tracking-widest mb-2">所 在</p>
            <h3 class="font-display text-2xl text-ink mb-3">Sở Tại</h3>
            <p class="text-ink-light leading-relaxed">
              Phương Trượng Sơn Môn — chân núi phía Đông.<br />
              Theo dòng suối ngược lên, đi qua ba cây tùng già, sẽ thấy gác đỏ ẩn dưới rặng trúc.
           </p>
         </div>

          <div>
            <p class="font-brush text-bronze text-2xl tracking-widest mb-2">時 辰</p>
            <h3 class="font-display text-2xl text-ink mb-3">Thời Khắc</h3>
            <p class="text-ink-light leading-relaxed">
              Mở cửa: <strong class="text-bronze-dark">Thìn Sơ</strong> (08:00)<br />
              Đóng cửa: <strong class="text-bronze-dark">Hợi Sơ</strong> (22:00)<br />
              <span class="text-sm italic text-ink-light/70">Quanh năm. Trừ ba ngày đầu tháng Giêng âm lịch.</span>
           </p>
         </div>

          <div>
            <p class="font-brush text-bronze text-2xl tracking-widest mb-2">傳 信</p>
            <h3 class="font-display text-2xl text-ink mb-3">Truyền Tin</h3>
            <ul class="space-y-2 text-ink-light">
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-bronze flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <a href="mailto:thuke@tangkinhcac.vn" class="hover:text-bronze">thuke@tangkinhcac.vn</a>
             </li>
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-bronze flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <span>Cánh hạc — gửi đến cổng Đông</span>
             </li>
           </ul>
         </div>
       </div>

        <!-- RIGHT — Quick Message -->
        <div class="card-glass" data-animate="fade-up">
          <h3 class="font-display text-2xl text-ink mb-2">Gửi Một Lời</h3>
          <p class="font-accent italic text-ink-light/70 text-sm mb-6">
            Không cần dài. Một dòng ngắn cũng đủ.
         </p>

          <form class="space-y-4">
            <input type="text" class="w-full px-4 py-3 bg-parchment border border-bronze/30 rounded-md focus:outline-none focus:border-bronze focus:ring-2 focus:ring-bronze/20 text-ink" placeholder="Pháp danh / Tên" />
            <input type="email" class="w-full px-4 py-3 bg-parchment border border-bronze/30 rounded-md focus:outline-none focus:border-bronze focus:ring-2 focus:ring-bronze/20 text-ink" placeholder="Cánh hạc / Email" />
            <textarea rows="5" class="w-full px-4 py-3 bg-parchment border border-bronze/30 rounded-md focus:outline-none focus:border-bronze focus:ring-2 focus:ring-bronze/20 text-ink resize-none" placeholder="Lời muốn nói..."></textarea>
            <button type="submit" class="btn-primary w-full">Gửi Đi</button>
         </form>
       </div>

     </div>
   </div>
 </section>

  <!-- QUOTE -->
  <section class="section-padding bg-parchment-warm">
    <div class="container-content text-center max-w-2xl">
      <div data-animate="fade-up">
        <p class="font-brush text-bronze text-3xl md:text-4xl tracking-widest mb-6">有 緣 千 里</p>
        <p class="font-display text-2xl md:text-3xl text-ink mb-3">Có duyên ngàn dặm cũng gặp</p>
        <p class="font-accent italic text-ink-light text-lg">Vô duyên đối diện chẳng thấy nhau.</p>
     </div>
   </div>
 </section>

</BaseLayout>
