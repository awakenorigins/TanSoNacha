---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { artists, trackId } from '../../../../data/amkinh';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const a of artists) {
    for (const al of a.albums) {
      for (const t of al.tracks) {
        if (!t.ready) continue;
        paths.push({ params: { artist: a.slug, album: al.slug, track: t.slug } });
      }
    }
  }
  return paths;
}

const { artist: artistSlug, album: albumSlug, track: trackSlug } = Astro.params;
const artist = artists.find((a) => a.slug === artistSlug)!;
const album = artist.albums.find((al) => al.slug === albumSlug)!;
const song = album.tracks.find((t) => t.slug === trackSlug)!;
const lyrics = song.lyrics || [];

// track id cho backend counter (đa-artist an toàn)
const TID = trackId(artist.slug, album.slug, song.slug);

// bài kế tiếp trong album (để auto-next / nút phát tiếp)
const readyTracks = album.tracks.filter((t) => t.ready);
const curIdx = readyTracks.findIndex((t) => t.slug === song.slug);
const nextTrack = readyTracks[(curIdx + 1) % readyTracks.length];

const SHARE_URL = `https://tangkinhcac.62.146.238.213.sslip.io/am-kinh/${artist.slug}/${album.slug}/${song.slug}`;
const SHARE_HASHTAGS = '#Phat #Phatphap #Minhtue #Nacha #Natra #xuhuong #giacngo #tieuthegioi #nacharium #nachaism #tansonacha #earth #mars #nacha #buddha #vodienphat #ॐ';
const SHARE_DEFAULT = `Pháp hay vốn chẳng tụ đây, Pháp hay là để share chung ta bà.

<svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5v7.2c0 3.6 2.1 6.2 3.5 7.8 1.4-1.6 3.5-4.2 3.5-7.8V4.5M6.5 10.5c1.8 1.5 3.2 3.4 5.5 3.4s3.7-1.9 5.5-3.4"/></svg> Đang nghe Âm Kinh: “${song.title}” — ${album.title} · ${artist.name} tại Tần Số Nacha.
${SHARE_URL}

${SHARE_HASHTAGS}`;
---

<BaseLayout
  title={`${song.title} — ${album.title} | Âm Kinh`}
  description={`${song.title} — ${artist.name}. Nghe Âm Kinh miễn phí tại Tần Số Nacha.`}
  ogImage={song.cover}
>
  <section class="section-dark relative overflow-hidden -mt-16 md:-mt-20 pt-24">
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(circle at 20% 20%, rgba(201,166,107,0.22), transparent 55%), radial-gradient(circle at 85% 75%, rgba(74,107,92,0.18), transparent 55%);"></div>

    <div class="container-content relative pb-16">
      <nav class="text-xs text-parchment/55 mb-6 flex items-center gap-3 flex-wrap">
        <a href={`/am-kinh/${artist.slug}/${album.slug}`} style="display:inline-flex;align-items:center;gap:.25rem;padding:.42rem .8rem;border-radius:999px;border:1px solid rgba(201,166,107,.4);background:rgba(201,166,107,.14);color:#F2E8D5;white-space:nowrap;" aria-label="Quay lại album">‹ Quay lại</a>
        <span>
          <a href="/am-kinh" class="hover:text-bronze-light">Âm Kinh</a><span class="mx-1">›</span>
          <a href={`/am-kinh/${artist.slug}`} class="hover:text-bronze-light">{artist.name}</a><span class="mx-1">›</span>
          <a href={`/am-kinh/${artist.slug}/${album.slug}`} class="hover:text-bronze-light">{album.title}</a><span class="mx-1">›</span>
          <span class="text-bronze-light">{song.title}</span>
       </span>
     </nav>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto items-start">
        <!-- LEFT: cover + controls -->
        <div class="flex flex-col items-center" data-animate="fade-up">
          <div class="nacha-cover-wrap relative w-64 h-64 md:w-80 md:h-80">
            <div id="nacha-vinyl" class="nacha-vinyl">
              <img id="nacha-vinyl-img" src={song.cover || album.cover || '/media/avatar/tieutam-01.jpg'} alt={song.title} class="w-full h-full object-cover rounded-full" />
              <span class="nacha-vinyl-hole"></span>
           </div>
            <script>
              // DĨA XOAY: random 1 trong 45 ảnh Tiểu Tâm mỗi lần mở (anh Nấng chỉ thị)
              const im = document.getElementById('nacha-vinyl-img') as HTMLImageElement | null;
              if (im && (!im.src || im.src.includes('/media/avatar/') || im.src.endsWith('nacha-tiger.jpg'))) {
                const n = 1 + Math.floor(Math.random() * 45);
                im.src = `/media/avatar/tieutam-${String(n).padStart(2, '0')}.jpg`;
              }
           </script>
            <div class="nacha-glow" aria-hidden="true"></div>
         </div>

          <p class="font-brush text-bronze-light text-2xl tracking-widest mt-8 mb-1">{song.cn}</p>
          <h1 class="font-display text-xl md:text-2xl text-parchment text-center px-4">{song.title}</h1>
          <p class="text-parchment/60 text-sm mt-1">{artist.name} · <span class="text-bronze-light">{album.title}</span></p>
          {song.tag && <span class="tag-bronze mt-3 !bg-bronze/15 !text-bronze-light !border-bronze-light/25">{song.tag}</span>}

          <audio id="nacha-audio" preload="auto" autoplay src={song.src}></audio>
          <span id="nacha-next-url" data-url={readyTracks.length > 1 ? `/am-kinh/${artist.slug}/${album.slug}/${nextTrack.slug}` : ""} hidden></span>

          <button id="nacha-tap" class="nacha-tap hidden" aria-label="Chạm để phát Âm Kinh">
            <span class="nacha-tap-ring"></span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span class="nacha-tap-text">Chạm để nghe Âm Kinh</span>
         </button>

          <div class="w-full max-w-sm mt-8">
            <div id="nacha-seek" class="nacha-seek"><div id="nacha-seek-fill" class="nacha-seek-fill"></div></div>
            <div class="flex justify-between text-xs text-parchment/50 mt-2 font-body">
              <span id="nacha-cur">0:00</span><span id="nacha-dur">{song.duration}</span>
           </div>
         </div>

          <div class="flex items-center gap-6 mt-6">
            <button id="nacha-back" class="nacha-ctrl-mini" aria-label="Tua lại 10 giây">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
           </button>
            <button id="nacha-play" class="nacha-play" aria-label="Phát / Dừng">
              <svg id="nacha-icon-play" class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="nacha-icon-pause" class="w-8 h-8 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
           </button>
            <button id="nacha-fwd" class="nacha-ctrl-mini" aria-label="Tua tới 10 giây">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
           </button>
         </div>

          <div class="flex items-center gap-3 mt-6">
            <a href={song.src} download class="btn-secondary !text-parchment !border-parchment/50 hover:!bg-parchment hover:!text-ink text-sm"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5v10M8.2 11.2 12 15l3.8-3.8M5.5 19.5h13"/></svg> Tải về</a>
            {readyTracks.length > 1 && (
              <a href={`/am-kinh/${artist.slug}/${album.slug}/${nextTrack.slug}`} class="btn-secondary !text-parchment !border-parchment/50 hover:!bg-parchment hover:!text-ink text-sm">Bài kế <svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 6.5 14 12l-7.5 5.5zM15.5 6.5v11"/></svg></a>
            )}
         </div>

          <!-- ACTIONS: Kính/reaction · Hoằng Dương · Comment · lượt nghe -->
          <div class="nacha-actions w-full max-w-sm mt-9" data-track={TID}>
            <div class="grid grid-cols-3 gap-2">
              <div class="nacha-react-wrap">
                <button class="nacha-act nacha-react-main" data-act="react" aria-label="Kính — đè để chọn cảm xúc">
                  <span class="nacha-act-ico" data-react-ico><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5v7.2c0 3.6 2.1 6.2 3.5 7.8 1.4-1.6 3.5-4.2 3.5-7.8V4.5M6.5 10.5c1.8 1.5 3.2 3.4 5.5 3.4s3.7-1.9 5.5-3.4"/></svg></span>
                  <span class="nacha-act-label" data-react-label>Kính</span>
                  <span class="nacha-act-num" data-num="react">0</span>
               </button>
                <div class="nacha-react-tray" hidden>
                  <button data-react="kinh" title="Kính"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5v7.2c0 3.6 2.1 6.2 3.5 7.8 1.4-1.6 3.5-4.2 3.5-7.8V4.5M6.5 10.5c1.8 1.5 3.2 3.4 5.5 3.4s3.7-1.9 5.5-3.4"/></svg></span><em data-rnum="kinh">0</em></button>
                  <button data-react="like" title="Thích"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.4C7.7 15.9 4.8 13.1 4.8 10c0-2.3 1.7-4.1 3.9-4.1 1.3 0 2.5.6 3.3 1.7.8-1.1 2-1.7 3.3-1.7 2.2 0 3.9 1.8 3.9 4.1 0 3.1-2.9 5.9-7.2 9.4Z"/></svg></span><em data-rnum="like">0</em></button>
                  <button data-react="sen" title="Sen"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 18.6c-2.5-1.9-3.8-4-3.8-6.4 0-2 1-4 3.8-7 2.8 3 3.8 5 3.8 7 0 2.4-1.3 4.5-3.8 6.4Z"/><path d="M9 16.6c-2.4-.6-4.3-2.1-5.2-4.8 2.3-.1 4 .6 5.2 2M15 16.6c2.4-.6 4.3-2.1 5.2-4.8-2.3-.1-4 .6-5.2 2M6.6 19.6h10.8"/></svg></span><em data-rnum="sen">0</em></button>
                  <button data-react="sang" title="Hào quang"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.2"/><path d="M12 3.6v2.6M12 17.8v2.6M3.6 12h2.6M17.8 12h2.6M6.2 6.2l1.8 1.8M16 16l1.8 1.8M17.8 6.2 16 8M8 16l-1.8 1.8"/></svg></span><em data-rnum="sang">0</em></button>
                  <button data-react="tue" title="An lạc"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.4 9.2A7 7 0 1 0 19 14.6"/><circle cx="12" cy="12" r="1.1"/></svg></span><em data-rnum="tue">0</em></button>
                  <button data-react="tym" title="Thương"><span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.4C7.7 15.9 4.8 13.1 4.8 10c0-2.3 1.7-4.1 3.9-4.1 1.3 0 2.5.6 3.3 1.7.8-1.1 2-1.7 3.3-1.7 2.2 0 3.9 1.8 3.9 4.1 0 3.1-2.9 5.9-7.2 9.4Z"/><path d="M8.4 11.4h2l1-1.6 1.4 2.8 1-1.2h1.8"/></svg></span><em data-rnum="tym">0</em></button>
               </div>
             </div>
              <button class="nacha-act" data-act="share" aria-label="Hoằng Dương — chia sẻ">
                <span class="nacha-act-ico"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5a7.5 7.5 0 1 0 7.5 7.5M12 4.5a7.5 7.5 0 0 1 7.5 7.5M12 2.8v3.4M12 17.8v3.4M4.2 12h3.4M16.4 12h3.4"/></svg></span>
                <span class="nacha-act-label">Hoằng Dương</span>
                <span class="nacha-act-num nacha-act-num--muted">Share</span>
             </button>
              <button class="nacha-act" data-act="comment" aria-label="Bình luận">
                <span class="nacha-act-ico"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 6.5h13v8.5h-7l-4.2 3.2V15h-1.8z"/></svg></span>
                <span class="nacha-act-label">Bình</span>
                <span class="nacha-act-num" data-num="comment">0</span>
             </button>
           </div>
            <p class="text-center text-xs text-parchment/55 mt-4">
              <span><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 14v-2a7 7 0 0 1 14 0v2M5 14h3v5H5zM16 14h3v5h-3z"/></svg></span>
              <span class="text-bronze-light font-semibold" data-num="play">0</span> lượt nghe · cùng chung tứ chúng
           </p>
         </div>
       </div>

        <!-- RIGHT: lyrics -->
        <div data-animate="fade-up">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-bronze-light animate-pulse"></span>
            <span class="font-chinese text-bronze-light text-sm tracking-widest">歌 詞 · Lyric tự chạy</span>
         </div>
          {lyrics.length > 0 ? (
            <div id="nacha-lyrics" class="nacha-lyrics">
              {lyrics.map((l, i) => (<p class="nacha-line" data-t={l.t} data-i={i}>{l.text}</p>))}
           </div>
          ) : (
            <div class="nacha-lyrics grid place-items-center text-parchment/40 text-sm">Chưa có lời cho bài này.</div>
          )}
       </div>
     </div>
   </div>

    <script type="application/json" id="nacha-lyric-data" set:html={JSON.stringify(lyrics)}></script>
 </section>

  <!-- COMMENTS -->
  <section id="nacha-comments-sec" class="section-dark relative" data-track={TID}>
    <div class="container-content max-w-2xl relative py-14">
      <div class="text-center mb-8" data-animate="fade-up">
        <span class="eyebrow text-bronze-light">菩 提 留 言</span>
        <h2 class="font-display text-2xl md:text-3xl text-parchment mt-1">Lời đạo hữu — <span data-num="comment">0</span> bình</h2>
        <p class="font-accent italic text-parchment/60 mt-3 text-sm">Mỗi lời là một chuyến kính gửi đến pháp giới.</p>
     </div>

      <div class="nacha-cbox" data-animate="fade-up">
        <div id="nacha-reply-hint" class="nacha-reply-hint">
          <span id="nacha-reply-to">Đang trả lời…</span>
          <button id="nacha-reply-cancel" aria-label="Hủy trả lời"><span aria-hidden="true">×</span></button>
       </div>
        <input id="nacha-cname" class="nacha-cinput-name" type="text" maxlength="40" placeholder="Tên của bạn (để trống = Ẩn danh)" />
        <div class="nacha-cinput-wrap">
          <textarea id="nacha-cbody" class="nacha-cinput-body" rows="3" maxlength="800" placeholder="Viết lời bình, lời nguyện…"></textarea>
          <div class="nacha-emoji-bar">
            <button type="button" class="nacha-emoji-toggle" aria-label="Thêm cảm xúc"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M9 10.2h.01M15 10.2h.01M8.8 14.2c.9 1 2 1.5 3.2 1.5s2.3-.5 3.2-1.5"/></svg></button>
            <div class="nacha-emoji-pop" hidden>
              <button type="button"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5v7.2c0 3.6 2.1 6.2 3.5 7.8 1.4-1.6 3.5-4.2 3.5-7.8V4.5M6.5 10.5c1.8 1.5 3.2 3.4 5.5 3.4s3.7-1.9 5.5-3.4"/></svg></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"><svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5a7.5 7.5 0 1 0 7.5 7.5M12 4.5a7.5 7.5 0 0 1 7.5 7.5M12 2.8v3.4M12 17.8v3.4M4.2 12h3.4M16.4 12h3.4"/></svg></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button><button type="button"></button>
           </div>
         </div>
       </div>
        <button id="nacha-csend" class="nacha-csend">Gửi lời bình</button>
        <p id="nacha-cmsg" class="nacha-cmsg" hidden></p>
     </div>

      <div id="nacha-clist" class="nacha-clist mt-8">
        <p class="nacha-cempty text-center text-parchment/45 text-sm py-6">Chưa có lời bình nào — hãy là người đầu tiên gửi lời kính <svg class="nacha-line-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 4.5v7.2c0 3.6 2.1 6.2 3.5 7.8 1.4-1.6 3.5-4.2 3.5-7.8V4.5M6.5 10.5c1.8 1.5 3.2 3.4 5.5 3.4s3.7-1.9 5.5-3.4"/></svg></p>
     </div>
   </div>
 </section>

  <!-- SHARE MODAL -->
  <div id="nacha-share-modal" class="nacha-modal" hidden>
    <div class="nacha-modal-backdrop" data-close></div>
    <div class="nacha-modal-card" role="dialog" aria-modal="true" aria-label="Hoằng Dương">
      <button class="nacha-modal-x" data-close aria-label="Đóng"><span aria-hidden="true">×</span></button>
      <div class="text-center mb-4">
        <p class="font-brush text-bronze-light text-xl tracking-widest">弘 揚</p>
        <h3 class="font-display text-2xl text-parchment mt-1">Hoằng Dương Pháp Âm</h3>
        <p class="text-parchment/60 text-xs mt-2 italic">Pháp hay vốn chẳng tụ đây · Pháp hay là để share chung ta bà</p>
     </div>
      <label class="nacha-share-lbl">Nội dung chia sẻ (sửa tự do)</label>
      <textarea id="nacha-share-text" class="nacha-share-text" rows="6">{SHARE_DEFAULT}</textarea>
      <div class="nacha-share-grid">
        <button class="nacha-share-btn nacha-share-fb" data-share="facebook"><span></span> Facebook</button>
        <button class="nacha-share-btn nacha-share-tt" data-share="tiktok"><span></span> TikTok</button>
        <button class="nacha-share-btn nacha-share-cp" data-share="copy"><span></span> Chép nội dung</button>
        <button class="nacha-share-btn nacha-share-native" data-share="native"><span></span> Ứng dụng khác</button>
     </div>
      <p id="nacha-share-note" class="nacha-share-note" hidden></p>
   </div>
 </div>

  <style is:global>
    .nacha-float svg { width: 1.25em; height: 1.25em; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    .nacha-line-ico { width: 1.05em; height: 1.05em; display: inline-block; fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; vertical-align: -0.16em; }
    /* Category cards */
    .nacha-cat--active {
      background: rgba(201,166,107,0.10);
      border-color: rgba(201,166,107,0.45);
      box-shadow: 0 8px 28px rgba(139,111,46,0.18);
    }
    .nacha-cat--active:hover { transform: translateY(-3px); border-color: rgba(201,166,107,0.75); }
    .nacha-cat--soon {
      background: rgba(242,232,213,0.04);
      border-color: rgba(242,232,213,0.10);
      opacity: 0.72;
      cursor: not-allowed;
    }

    /* Vinyl cover */
    .nacha-cover-wrap { display: grid; place-items: center; }
    .nacha-vinyl {
      position: relative;
      width: 100%; height: 100%;
      border-radius: 9999px;
      padding: 8px;
      background: conic-gradient(from 0deg, #1a1510, #3E2614, #1a1510, #5C4A1F, #1a1510);
      box-shadow: 0 20px 60px rgba(0,0,0,0.55), inset 0 0 0 2px rgba(201,166,107,0.25);
      animation: nacha-spin 22s linear infinite;
      animation-play-state: paused;
    }
    .nacha-vinyl.spinning { animation-play-state: running; }
    .nacha-vinyl img {
      background: #F8F1E0;
      box-shadow: inset 0 0 0 6px rgba(0,0,0,0.4);
    }
    .nacha-vinyl-hole {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 26px; height: 26px; border-radius: 9999px;
      background: #1F1A14; box-shadow: 0 0 0 4px rgba(201,166,107,0.4);
    }
    .nacha-glow {
      position: absolute; inset: -18%;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(201,166,107,0.35), transparent 65%);
      filter: blur(22px); z-index: -1;
      animation: nacha-breathe 4s ease-in-out infinite;
    }
    @keyframes nacha-spin { to { transform: rotate(360deg); } }
    @keyframes nacha-breathe { 0%,100% { opacity: 0.5; } 50% { opacity: 0.95; } }

    /* Play controls */
    .nacha-play {
      width: 72px; height: 72px; border-radius: 9999px;
      display: grid; place-items: center;
      color: #F2E8D5; background: #8B6F2E;
      box-shadow: 0 10px 30px rgba(139,111,46,0.5);
      transition: transform .25s ease, background .25s ease;
    }
    .nacha-play:hover { transform: scale(1.06); background: #9c7c34; }
