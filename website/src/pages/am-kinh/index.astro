---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { artists, albumReadyCount } from '../../data/amkinh';

const artPool = [
  '/images/tieu-tam/avatar_1.jpg','/images/tieu-tam/avatar_2.jpg','/images/tieu-tam/avatar_3.jpg','/images/tieu-tam/avatar_4.jpg',
  '/images/tieu-tam/avatar_5.jpg','/images/tieu-tam/avatar_6.jpg','/images/tieu-tam/avatar_7.jpg','/images/tieu-tam/avatar_8.jpg',
].filter(Boolean);
function hash(s: string): number { return [...s].reduce((n, c) => ((n * 31) + c.charCodeAt(0)) >>> 0, 7); }
function albumCover(album: any, artist: any): string { return artPool[hash(album.slug || album.title) % artPool.length]; }
function cleanTitle(input = ''): string {
  return input
    .replace(/\s*\([^)]*(?:snap\s*v\d*|ThichCa|Lv\d|BedroomPop|bedroom\s*pop)[^)]*\)\s*/gi, ' ')
    .replace(/^\s*Lv\d+\s+[\p{L}\d&/·\- ]{2,32}?\s+(?=[A-ZÀ-Ỵ])/u, '')
    .replace(/\bLv\d+\b/gi, '')
    .replace(/\s{2,}/g, ' ')
    .trim();
}
function genreOf(track: any, album: any): string {
  const text = `${track.tag || ''} ${track.title || ''} ${album.title || ''}`.toLowerCase();
  if (/lofi|chill|bedroom|pop/.test(text)) return 'Lofi · Chill';
  if (/như lai|nhu lai/.test(text)) return 'Như Lai';
  if (/minh tuệ|minh tue/.test(text)) return 'Minh Tuệ';
  if (/buông|buong|healing|sleep/.test(text)) return 'Buông nhẹ';
  if (/thở|tho|breath|thiền|thien/.test(text)) return 'Hơi thở';
  return 'Phật Pháp';
}
const readyAlbums = artists.flatMap((artist) => artist.albums.filter((album) => albumReadyCount(album) > 0).map((album) => ({ artist, album, cover: albumCover(album, artist), count: albumReadyCount(album) })));
const genres = ['Tất cả','Phật Pháp','Lofi · Chill','Như Lai','Minh Tuệ','Buông nhẹ','Hơi thở'];
---

<BaseLayout
  title="Âm Kinh 音經 — Music Home | Tần Số Nacha"
  description="Âm Kinh — nghe nhạc Phật của Tiểu Tâm, khám phá album và tần số Nacha."
>
  <main class="amk-home" data-amk-home>
    <section class="amk-shell amk-top">
      <p class="amk-kicker">音經 · Tần số Nacha</p>
      <div class="amk-now" id="amkNowCard">
        <img id="amkCover" src={readyAlbums[0]?.cover || '/images/art/img-03-square.jpg'} alt="Bìa bài đang phát" />
        <div class="amk-now-text">
          <span>Đang phát</span>
          <h1 id="amkTitle">Âm Kinh</h1>
          <p id="amkMeta">Tiểu Tâm · Nhạc Phật</p>
          <p id="amkPlays" class="amk-plays">Đang nạp lượt phát…</p>
       </div>
        <div class="amk-now-actions">
          <button class="amk-primary" id="amkPlay" type="button"><svg class="amk-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4L18.5 12z"/></svg></button>
          <button class="amk-ghost" id="amkNext" type="button"><svg class="amk-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7.5h2.4c2.7 0 4.2 9 7.4 9h1.4M4.5 16.5h2.4c1.2 0 2.2-1.8 3.2-3.8M14.3 7.5h1.4M15.4 4.9l3.1 2.6-3.1 2.6M15.4 13.9l3.1 2.6-3.1 2.6"/></svg></button>
       </div>
     </div>
      <p class="amk-fallback" id="amkFallback" hidden>Chạm <svg class="amk-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4L18.5 12z"/></svg> để mở âm thanh.</p>
   </section>

    <section class="amk-shell amk-section amk-bxh" id="amkBxh" aria-label="Bảng xếp hạng">
      <div class="amk-title-row"><h2>Bảng Xếp Hạng</h2>
        <div class="amk-bxh-tabs" role="tablist">
          <button type="button" data-period="day" class="is-active">Ngày</button>
          <button type="button" data-period="week">Tuần</button>
          <button type="button" data-period="month">Tháng</button>
        </div>
      </div>
      <ol id="amkBxhList" class="amk-bxh-list"><li class="amk-bxh-empty">Đang xếp hạng…</li></ol>
    </section>

    <section class="amk-shell amk-section">
      <div class="amk-title-row"><h2>Nghe tiếp</h2><span>{readyAlbums.length} album</span></div>
      <div class="amk-scroll-row" aria-label="Album nổi bật">
        {readyAlbums.slice(0, 14).map(({ artist, album, cover, count }) => (
          <a class="amk-album-tile" href={`#album-${album.slug}`} data-genre={genreOf(album.tracks.find((t) => t.ready) || {}, album)}>
            <img src={cover} alt={album.title} loading="eager" />
            <strong>{album.title}</strong>
            <small>{artist.name} · {count} bài</small>
         </a>
        ))}
     </div>
   </section>

    <section class="amk-shell amk-section amk-genres" aria-label="Thể loại">
      {genres.map((g) => <button type="button" class:list={["amk-genre", g === 'Tất cả' && 'is-active']} data-genre={g}>{g}</button>)}
   </section>

    <section class="amk-shell amk-section">
      <div class="amk-title-row"><h2>Tất cả album</h2><span id="amkGridCount">{readyAlbums.length}</span></div>
      <div class="amk-grid" id="amkAlbumGrid">
        {readyAlbums.map(({ artist, album, cover, count }) => {
          const first = album.tracks.find((t) => t.ready) || album.tracks[0] || {};
          const g = genreOf(first, album);
          return (
            <article class="amk-grid-card" id={`album-${album.slug}`} data-genre={g}>
              <a href={`/am-kinh/${artist.slug}/${album.slug}/`} aria-label={`Mở ${album.title}`}>
                <img src={cover} alt={album.title} loading="lazy" />
                <strong>{album.title}</strong>
                <small>{artist.name} · {g} · {count} bài</small>
             </a>
              <button type="button" class="amk-card-play" data-album={album.slug}>Phát ngẫu nhiên</button>
           </article>
          );
        })}
     </div>
   </section>
 </main>

  <div class="amk-mini" id="amkMini" aria-live="polite">
    <button id="amkMiniPlay" type="button"><svg class="amk-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4L18.5 12z"/></svg></button>
    <div><strong id="amkMiniTitle">Âm Kinh</strong><small id="amkMiniMeta">Sẵn sàng</small></div>
    <button id="amkMiniNext" type="button"><svg class="amk-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7.5h2.4c2.7 0 4.2 9 7.4 9h1.4M4.5 16.5h2.4c1.2 0 2.2-1.8 3.2-3.8M14.3 7.5h1.4M15.4 4.9l3.1 2.6-3.1 2.6M15.4 13.9l3.1 2.6-3.1 2.6"/></svg></button>
 </div>
  <audio id="amkAudio" preload="metadata"></audio>

  <script define:vars={{ artists, artPool }}>
    const hash = (s) => [...String(s)].reduce((n,c)=>((n*31)+c.charCodeAt(0))>>>0,7);
    const cleanTitle = (s='') => String(s).replace(/\s*\([^)]*(?:snap\s*v\d*|ThichCa|Lv\d|BedroomPop|bedroom\s*pop)[^)]*\)\s*/gi,' ').replace(/^\s*Lv\d+\s+[\p{L}\d&/·\- ]{2,32}?\s+(?=[A-ZÀ-Ỵ])/u,'').replace(/\bLv\d+\b/gi,'').replace(/\s{2,}/g,' ').trim();
    const genreOf = (t, al) => { const text = `${t.tag||''} ${t.title||''} ${al.title||''}`.toLowerCase(); if(/lofi|chill|bedroom|pop/.test(text)) return 'Lofi · Chill'; if(/như lai|nhu lai/.test(text)) return 'Như Lai'; if(/minh tuệ|minh tue/.test(text)) return 'Minh Tuệ'; if(/buông|buong|healing|sleep/.test(text)) return 'Buông nhẹ'; if(/thở|tho|breath|thiền|thien/.test(text)) return 'Hơi thở'; return 'Phật Pháp'; };
    const coverFor = (al,a,t={}) => artPool[hash(al.slug || al.title) % artPool.length];
    const tracks = artists.flatMap(a => a.albums.flatMap(al => al.tracks.filter(t => t.ready).map(t => ({...t, title: cleanTitle(t.title), rawTitle:t.title, artist:a.name, album:al.title, albumSlug:al.slug, tid:`${a.slug}:${al.slug}:${t.slug}`, genre:genreOf(t,al), cover:coverFor(al,a,t)}))));
    const $ = (id) => document.getElementById(id);
    const audio=$('amkAudio'), playBtn=$('amkPlay'), nextBtn=$('amkNext'), miniPlay=$('amkMiniPlay'), miniNext=$('amkMiniNext');
    const title=$('amkTitle'), meta=$('amkMeta'), cover=$('amkCover'), fb=$('amkFallback'), mt=$('amkMiniTitle'), mm=$('amkMiniMeta'), gridCount=$('amkGridCount');
    const playsEl=$('amkPlays');
    const IC={play:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 5.8v12.4L18.5 12z"/></svg>',pause:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6.2v11.6M15 6.2v11.6"/></svg>',shuffle:'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7.5h2.4c2.7 0 4.2 9 7.4 9h1.4M4.5 16.5h2.4c1.2 0 2.2-1.8 3.2-3.8M14.3 7.5h1.4M15.4 4.9l3.1 2.6-3.1 2.6M15.4 13.9l3.1 2.6-3.1 2.6"/></svg>'};
    [playBtn,miniPlay].forEach(b=>{ if(b) b.innerHTML=IC.play; }); [nextBtn,miniNext].forEach(b=>{ if(b) b.innerHTML=IC.shuffle; });
    let current=null, recent=[], activeGenre='Tất cả';
    const countedPlays = new Set();
    function pool(){ const base = activeGenre === 'Tất cả' ? tracks : tracks.filter(t => t.genre === activeGenre); return base.length ? base : tracks; }
    function pick(extra = {}){ const base=pool().filter(t => !recent.includes(t.src)); const list=base.length?base:pool(); const t=list[Math.floor(Math.random()*list.length)]; if(t) recent=[t.src,...recent].slice(0,18); return t; }
    function setTrack(t, autoplay=false){ if(!t) return; current=t; audio.src=t.src; title.textContent=t.title; meta.textContent=`${t.artist} · ${t.album}`; cover.src=t.cover; mt.textContent=t.title; mm.textContent=t.artist; refreshPlays(); if(autoplay) play(); }
    async function refreshPlays(){ if(!current||!playsEl) return; try{ const r=await fetch(`/api/stats?track=${encodeURIComponent(current.tid)}`); const d=await r.json(); const n=d?.stats?.play??0; playsEl.textContent=`${Number(n).toLocaleString('vi-VN')} lượt đã phát`; }catch{ playsEl.textContent='Lượt phát đang đồng bộ'; } }
    async function countPlay(){ if(!current||countedPlays.has(current.tid)) return; countedPlays.add(current.tid); try{ const r=await fetch('/api/hit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({track:current.tid,metric:'play'})}); const d=await r.json(); const n=d?.stats?.play; if(playsEl&&typeof n==='number') playsEl.textContent=`${Number(n).toLocaleString('vi-VN')} lượt đã phát`; }catch{} }
    async function play(){ try{ await audio.play(); playBtn.innerHTML=IC.pause; miniPlay.innerHTML=IC.pause; fb.hidden=true; countPlay(); }catch(e){ fb.hidden=false; playBtn.innerHTML=IC.play; miniPlay.innerHTML=IC.play; } }
    function pause(){ audio.pause(); playBtn.innerHTML=IC.play; miniPlay.innerHTML=IC.play; }
    function toggle(){ audio.paused ? play() : pause(); }
    function next(){ setTrack(pick(), true); }
    function filterGenre(g, autoplay=true){ activeGenre=g; document.querySelectorAll('.amk-genre').forEach(b=>b.classList.toggle('is-active', b.dataset.genre===g)); let shown=0; document.querySelectorAll('.amk-grid-card').forEach(card=>{ const ok=g==='Tất cả'||card.dataset.genre===g; card.hidden=!ok; if(ok) shown++; }); gridCount.textContent=shown; if(autoplay && g !== 'Tất cả') setTrack(pick(), true); }
    document.querySelectorAll('.amk-genre').forEach(b=>b.addEventListener('click',()=>filterGenre(b.dataset.genre, true)));
    document.querySelectorAll('.amk-card-play').forEach(b=>b.addEventListener('click',()=>{ const list=tracks.filter(t=>t.albumSlug===b.dataset.album); setTrack(list[Math.floor(Math.random()*list.length)], true); }));
    [playBtn,miniPlay].forEach(b=>b.addEventListener('click',toggle)); [nextBtn,miniNext].forEach(b=>b.addEventListener('click',next)); audio.addEventListener('ended', next);
    const bxhList=$('amkBxhList');
    const byTid=new Map(tracks.map(t=>[t.tid,t]));
    const escH=(x)=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
    const fmtN=(n)=>Number(n||0).toLocaleString('vi-VN');
    function bxhRow(it,i){
      const t=byTid.get(it.tid);
      const title=t?t.title:it.tid.split(':').pop().replace(/-/g,' ');
      const cov=t?t.cover:artPool[i%artPool.length];
      const url='/am-kinh/'+it.tid.split(':').join('/')+'/';
      const delta=it.dPlay>0?'<span class="bxh-delta">+'+fmtN(it.dPlay)+'</span>':'<span class="bxh-delta bxh-delta--dim">—</span>';
      return '<li class="amk-bxh-row'+(i<3?' bxh-top'+(i+1):'')+'" data-url="'+url+'"><span class="bxh-rank">'+(i+1)+'</span><img src="'+cov+'" alt="" loading="lazy"/><div class="bxh-info"><strong>'+escH(title)+'</strong><small>'+fmtN(it.play)+' nghe · '+fmtN(it.like)+' kính · '+fmtN(it.comment)+' bình</small></div>'+delta+'</li>';
    }
    let hotMarked=false;
    async function loadBxh(p){
      try{
        const r=await fetch('/api/top?period='+p+'&limit=20');
        const d=await r.json();
        if(!d.ok||!bxhList) return;
        bxhList.innerHTML=d.items.map(bxhRow).join('')||'<li class="amk-bxh-empty">Chưa có dữ liệu.</li>';
        if(!hotMarked&&d.items.length){
          hotMarked=true;
          d.items.slice(0,5).forEach(it=>{
            const al=it.tid.split(':')[1];
            const card=document.getElementById('album-'+al);
            if(card) card.classList.add('amk-hot');
          });
        }
      }catch{}
    }
    bxhList&&bxhList.addEventListener('click',(e)=>{const row=e.target.closest('.amk-bxh-row');if(row&&row.dataset.url)location.href=row.dataset.url;});
    document.querySelectorAll('.amk-bxh-tabs button').forEach(b=>b.addEventListener('click',()=>{
      document.querySelectorAll('.amk-bxh-tabs button').forEach(x=>x.classList.toggle('is-active',x===b));
      loadBxh(b.dataset.period);
    }));
    loadBxh('day'); setInterval(()=>{const act=document.querySelector('.amk-bxh-tabs button.is-active');loadBxh(act?act.dataset.period:'day');},60000);
    const opener=tracks.find(t=>t.tid==='tieu-tam:already-phat:da-nam-mo'); if(opener) recent=[opener.src]; setTrack(opener||pick(), false); play(); setInterval(refreshPlays,15000);
 </script>

  <style is:global>
    .amk-ico{width:1.05em;height:1.05em;display:inline-block;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.16em}.amk-ico path[d^="M8.5"]{fill:currentColor;stroke:none}
    :root{--amk-ink:#100b08;--amk-bronze:#C9A96E;--amk-paper:#f4e7cf;--amk-muted:rgba(244,231,207,.66)}
    .amk-home{min-height:100vh;background:radial-gradient(circle at 50% -12%,rgba(201,169,110,.22),transparent 34rem),linear-gradient(180deg,#17100c 0%,var(--amk-ink) 38%);color:var(--amk-paper);padding:5.25rem 0 calc(12.5rem + env(safe-area-inset-bottom));font-family:Inter,system-ui,sans-serif}.amk-shell{width:min(1100px,92vw);margin:auto}.amk-kicker{margin:0 0 .7rem;color:var(--amk-bronze);letter-spacing:.22em;text-transform:uppercase;font-size:.72rem}.amk-top{padding-top:.35rem}.amk-now{display:grid;grid-template-columns:76px 1fr auto;gap:.9rem;align-items:center;padding:.72rem;border:1px solid rgba(201,169,110,.18);border-radius:24px;background:rgba(255,246,225,.07);box-shadow:0 18px 55px rgba(0,0,0,.28);backdrop-filter:blur(18px)}.amk-now img{width:76px;height:76px;aspect-ratio:1;border-radius:18px;object-fit:cover;background:#25170f}.amk-now-text{min-width:0}.amk-now-text span{color:var(--amk-bronze);font-size:.72rem;font-weight:700}.amk-now h1{margin:.12rem 0;font-size:clamp(1.15rem,5vw,2rem);line-height:1.08;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.amk-now p{margin:0;color:var(--amk-muted);font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.amk-now .amk-plays{margin-top:.16rem;color:var(--amk-bronze);font-size:.78rem}.amk-now-actions{display:flex;gap:.45rem}.amk-primary,.amk-ghost,.amk-genre,.amk-card-play,.amk-mini button{border:0;border-radius:999px;color:#160d07;background:var(--amk-bronze);font-weight:800}.amk-primary,.amk-ghost,.amk-mini button{width:44px;height:44px;display:grid;place-items:center}.amk-primary svg,.amk-ghost svg,.amk-mini button svg{width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:1.55;stroke-linecap:round;stroke-linejoin:round}.amk-primary svg path:first-child{fill:currentColor;stroke:none}.amk-primary svg path[d^="M9"],.amk-mini button svg path[d^="M9"]{fill:none;stroke:currentColor}.amk-ghost{background:rgba(244,231,207,.1);color:var(--amk-paper);border:1px solid rgba(2