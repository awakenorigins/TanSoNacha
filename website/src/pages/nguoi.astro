---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Bảng Công Đức — Tần Số Nacha" description="Bảng Công Đức của mỗi Phật tử tại Tần Số Nacha.">
  <section class="social-profile-shell">
    <div class="profile-aura" aria-hidden="true"></div>
    <main class="profile-wrap">
      <div id="profile-loading" class="profile-state">Đang mở Bảng Công Đức…</div>
      <div id="profile-error" class="profile-state profile-error" hidden></div>
      <article id="profile-card" class="profile-card" hidden>
        <div class="profile-cover"><div class="mandala"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2.2"/><path d="M12 3.5v6.3M12 14.2v6.3M3.5 12h6.3M14.2 12h6.3M6 6l4.45 4.45M13.55 13.55 18 18M18 6l-4.45 4.45M10.45 13.55 6 18"/></svg></div></div>
        <div class="profile-body">
          <div id="profile-avatar" class="profile-avatar">那</div>
          <div class="identity">
            <p class="eyebrow">BẢNG CÔNG ĐỨC · 功德榜</p>
            <h1 id="profile-name">Pháp Danh</h1>
            <div class="badges"><span id="profile-pham"></span><span id="profile-role" hidden>Thủ Các</span></div>
         </div>
          <button id="edit-toggle" class="edit-btn" hidden>Chỉnh Bảng</button>
       </div>
        <div class="profile-content">
          <blockquote id="profile-vow">Một niệm thiện khởi, vạn duyên lành sinh.</blockquote>
          <p id="profile-bio" class="bio"></p>
          <div id="profile-tags" class="tags"></div>
          <div class="stats"><div><b id="stat-posts">0</b><span>Duyên đã viết</span></div><div><b id="stat-followers">0</b><span>Người đồng hành</span></div></div>
       </div>
     </article>
      <form id="profile-form" class="profile-form" hidden>
        <h2>Chỉnh Bảng Công Đức</h2>
        <label>Lời nguyện <input id="edit-vow" maxlength="120" placeholder="Một lời nguyện mỗi ngày…" /></label>
        <label>Đôi dòng về mình <textarea id="edit-bio" maxlength="300" rows="4" placeholder="Hành trình tu học của bạn…"></textarea></label>
        <label>Thẻ tu tập <input id="edit-tags" maxlength="150" placeholder="Nghe Kinh, Hành Thiện, Thiền Tập" /><small>Tối đa 8 thẻ, ngăn cách bằng dấu phẩy.</small></label>
        <label>Hạt avatar <input id="edit-seed" maxlength="80" placeholder="Tên hạt riêng của bạn" /></label>
        <label>Ai được xem <select id="edit-visibility"><option value="public">Mọi người</option><option value="members">Người trong cõi</option><option value="private">Tĩnh tu riêng</option></select></label>
        <div class="form-actions"><button type="button" id="edit-cancel">Thôi</button><button type="submit">Lưu Duyên</button></div>
        <p id="form-msg"></p>
     </form>
      <section class="wall-social">
        <form id="post-form" class="composer" hidden><textarea id="post-body" maxlength="4000" rows="3" placeholder="Gieo một lời lành lên Bảng…"></textarea><div><select id="post-visibility"><option value="members">Người trong cõi</option><option value="public">Mọi người</option><option value="private">Riêng mình</option></select><button type="submit">Gieo Lời</button></div><p id="post-msg"></p></form>
        <div class="wall-title"><span>蓮</span><div><h2>Lời trên Bảng</h2><p>Bài viết, lời ghé và những duyên lành.</p></div></div>
        <div id="post-list" class="post-list"><p class="wall-wait">Đang kết duyên…</p></div>
     </section>
   </main>
 </section>
  <style>
    .social-profile-shell{min-height:100vh;background:#11100f;color:#f5f0eb;position:relative;overflow:hidden;padding:4rem 1rem 6rem}.profile-aura{position:absolute;inset:-20%;background:radial-gradient(circle at 50% 15%,rgba(201,169,110,.22),transparent 34%),radial-gradient(circle at 20% 70%,rgba(139,26,47,.12),transparent 30%);pointer-events:none}.profile-wrap{position:relative;max-width:780px;margin:auto}.profile-state{text-align:center;padding:5rem;color:#c9a96e}.profile-error{color:#e4a4aa}.profile-card,.profile-form,.wall-empty{border:1px solid rgba(201,169,110,.25);background:rgba(245,240,235,.045);backdrop-filter:blur(16px);border-radius:24px;overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,.35)}.profile-cover{height:190px;background:radial-gradient(circle,rgba(201,169,110,.25),transparent 45%),linear-gradient(135deg,#271f18,#481a25 55%,#171513);display:grid;place-items:center;overflow:hidden}.mandala{font-size:9rem;color:rgba(201,169,110,.18);filter:drop-shadow(0 0 25px rgba(201,169,110,.35));animation:turn 40s linear infinite;display:inline-grid;place-items:center}.mandala svg{width:1em;height:1em}@keyframes turn{to{transform:rotate(360deg)}}.profile-body{display:flex;align-items:flex-end;gap:1rem;padding:0 2rem 1.4rem;margin-top:-42px}.profile-avatar{width:92px;height:92px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(145deg,#c9a96e,#6d442d);border:4px solid #161412;color:#17130f;font:700 2rem serif;box-shadow:0 8px 30px #000}.identity{flex:1}.eyebrow{font-size:.65rem;letter-spacing:.2em;color:#c9a96e;margin-bottom:.25rem}.identity h1{font:700 2rem 'Playfair Display',serif}.badges{display:flex;gap:.45rem}.badges span{font-size:.68rem;padding:.25rem .55rem;border-radius:99px;background:rgba(201,169,110,.14);color:#d8bd89}.edit-btn,.form-actions button{border:1px solid #c9a96e;border-radius:99px;padding:.55rem 1rem;color:#f5f0eb;background:transparent}.edit-btn:hover,.form-actions button:last-child{background:#c9a96e;color:#17130f}.profile-content{padding:0 2rem 2rem}.profile-content blockquote{font:italic 1.25rem 'Playfair Display',serif;color:#ddc99f;border-left:2px solid #c9a96e;padding-left:1rem;margin:1rem 0}.bio{color:rgba(245,240,235,.72);line-height:1.7}.tags{display:flex;flex-wrap:wrap;gap:.4rem;margin:1rem 0}.tags span{font-size:.72rem;padding:.35rem .65rem;border-radius:99px;background:rgba(184,201,192,.12);color:#b8c9c0}.stats{display:flex;gap:2rem;border-top:1px solid rgba(201,169,110,.14);padding-top:1rem}.stats div{display:flex;flex-direction:column}.stats b{font:700 1.4rem serif;color:#c9a96e}.stats span{font-size:.68rem;color:rgba(245,240,235,.5)}.profile-form{margin-top:1rem;padding:1.5rem 2rem}.profile-form h2{font:700 1.4rem serif;color:#c9a96e;margin-bottom:1rem}.profile-form label{display:block;font-size:.78rem;color:#d8bd89;margin:.9rem 0}.profile-form input,.profile-form textarea,.profile-form select{display:block;width:100%;margin-top:.35rem;border:1px solid rgba(201,169,110,.3);border-radius:12px;background:#1d1a17;color:#f5f0eb;padding:.7rem}.profile-form small{color:rgba(245,240,235,.45)}.form-actions{display:flex;justify-content:flex-end;gap:.6rem}.wall-empty{text-align:center;margin-top:1rem;padding:2rem}.wall-empty span{font-size:2rem;color:#c9a96e}.wall-empty h2{font:700 1.25rem serif}.wall-empty p{font-size:.8rem;color:rgba(245,240,235,.5)}#form-msg{font-size:.78rem;text-align:right;color:#b8c9c0;margin-top:.7rem}@media(max-width:560px){.social-profile-shell{padding:2rem .7rem 6rem}.profile-cover{height:150px}.profile-body{padding:0 1rem 1rem;align-items:center;flex-wrap:wrap}.profile-avatar{width:76px;height:76px}.identity h1{font-size:1.55rem}.profile-content,.profile-form{padding-left:1rem;padding-right:1rem}.edit-btn{margin-left:auto}.mandala{font-size:7rem}}@media(prefers-reduced-motion:reduce){.mandala{animation:none}}
    .wall-social{margin-top:1rem}.wall-title,.composer,.post-card{border:1px solid rgba(201,169,110,.22);background:rgba(245,240,235,.04);border-radius:18px}.wall-title{display:flex;gap:.75rem;align-items:center;padding:1rem 1.2rem}.wall-title>span{font-size:1.8rem;color:#c9a96e}.wall-title h2{font:700 1.2rem serif}.wall-title p,.wall-wait{font-size:.75rem;color:rgba(245,240,235,.48)}.composer{padding:1rem;margin-bottom:.8rem}.composer textarea{width:100%;background:transparent;color:#fff;outline:0;resize:vertical;line-height:1.6}.composer>div{display:flex;justify-content:flex-end;gap:.5rem;border-top:1px solid rgba(201,169,110,.12);padding-top:.6rem}.composer select,.composer button{border:1px solid rgba(201,169,110,.3);border-radius:99px;background:#1d1a17;color:#d8bd89;padding:.4rem .7rem;font-size:.72rem}.composer button{background:#c9a96e;color:#17130f;font-weight:700}.post-list{display:grid;gap:.7rem;margin-top:.7rem}.post-card{padding:1rem 1.1rem}.post-head{display:flex;align-items:center;gap:.5rem}.post-head b{color:#eadbbd}.post-head small{color:rgba(245,240,235,.42);font-size:.67rem;flex:1}.post-text{white-space:pre-wrap;line-height:1.65;margin:.75rem 0;color:rgba(245,240,235,.84)}.post-actions{display:flex;gap:.4rem}.post-actions button{border:1px solid rgba(201,169,110,.18);border-radius:99px;padding:.32rem .65rem;color:#d8bd89;font-size:.7rem}.post-actions button.on{background:rgba(201,169,110,.18)}.reply-list{margin-top:.65rem;display:grid;gap:.35rem}.reply-list p{font-size:.76rem;padding:.45rem .6rem;background:rgba(255,255,255,.035);border-radius:9px}.reply-form{display:flex;gap:.4rem;margin-top:.55rem}.reply-form input{flex:1;min-width:0;border:1px solid rgba(201,169,110,.2);border-radius:99px;background:#191714;color:#fff;padding:.45rem .7rem}.reply-form button{color:#c9a96e;font-size:.72rem}#post-msg{font-size:.72rem;color:#b8c9c0;text-align:right;margin-top:.4rem}
 </style>
  <script>
    const API='/pp-api';
    const $=(id:string)=>document.getElementById(id)!;
    const esc=(s:string)=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
    let token=''; let profile:any=null;
    try{token=localStorage.getItem('pp-token')||''}catch{}
    const params=new URLSearchParams(location.search);
    async function load(){
      const query=params.get('id')?`publicId=${encodeURIComponent(params.get('id')!)}`:params.get('p')?`phapdanh=${encodeURIComponent(params.get('p')!)}`:token?`token=${encodeURIComponent(token)}`:'';
      if(!query){$('profile-loading').hidden=true;$('profile-error').hidden=false;$('profile-error').textContent='Xin vào cõi hoặc chọn một Pháp Danh để mở Bảng.';return}
      try{const r=await fetch(`${API}/profile?${query}`,{headers:token?{'X-PP-Token':token}:{}});const d=await r.json();if(!d.ok)throw new Error(d.error||'Không mở được Bảng');profile=d.profile;render()}catch(e:any){$('profile-loading').hidden=true;$('profile-error').hidden=false;$('profile-error').textContent=e.message}
    }
    function render(){$('profile-loading').hidden=true;$('profile-card').hidden=false;$('profile-name').textContent=profile.phapdanh;$('profile-pham').textContent=`Phẩm ${profile.rank} · ${profile.pham}`;$('profile-role').hidden=profile.role!=='admin';$('profile-vow').textContent=profile.vow||'Một niệm thiện khởi, vạn duyên lành sinh.';$('profile-bio').textContent=profile.bio||'Đạo hữu chưa viết đôi dòng về hành trình của mình.';$('profile-avatar').textContent=(profile.phapdanh||'那').trim().slice(0,1).toUpperCase();$('profile-avatar').style.background=`linear-gradient(145deg,hsl(${hash(profile.avatarSeed)%360} 48% 65%),#6d442d)`;$('profile-tags').innerHTML=(profile.tags||[]).map((t:string)=>`<span>${esc(t)}</span>`).join('');$('stat-posts').textContent=profile.stats?.posts||'0';$('stat-followers').textContent=profile.stats?.followers||'0';$('edit-toggle').hidden=!profile.isSelf}
    function hash(s:string){let h=0;for(const c of String(s||''))h=(h*31+c.charCodeAt(0))|0;return Math.abs(h)}
    $('edit-toggle').addEventListener('click',()=>{ $('profile-form').hidden=false;$('edit-vow').value=profile.vow||'';$('edit-bio').value=profile.bio||'';$('edit-tags').value=(profile.tags||[]).join(', ');$('edit-seed').value=profile.avatarSeed||'';$('edit-visibility').value=profile.visibility||'public';$('profile-form').scrollIntoView({behavior:'smooth'}) });
    $('edit-cancel').addEventListener('click',()=>{$('profile-form').hidden=true});
    $('profile-form').addEventListener('submit',async(e)=>{e.preventDefault();$('form-msg').textContent='Đang lưu…';const body={vow:$('edit-vow').value,bio:$('edit-bio').value,tags:$('edit-tags').value.split(',').map(x=>x.trim()).filter(Boolean),avatarSeed:$('edit-seed').value,visibility:$('edit-visibility').value};try{const r=await fetch(`${API}/profile/update`,{method:'POST',headers:{'Content-Type':'application/json','X-PP-Token':token},body:JSON.stringify(body)});const d=await r.json();if(!d.ok)throw new Error(d.error);profile={...profile,...d.profile,stats:profile.stats};render();$('form-msg').textContent='Đã lưu duyên lành';setTimeout(()=>{$('profile-form').hidden=true},700)}catch(e:any){$('form-msg').textContent=e.message||'Chưa lưu được'}});
    const socialHeaders=()=>token?{'X-PP-Token':token}:{};
    const ago=(ts:number)=>{const s=Math.max(0,Math.floor((Date.now()-ts)/1000));return s<60?'vừa xong':s<3600?`${Math.floor(s/60)} phút`:s<86400?`${Math.floor(s/3600)} giờ`:`${Math.floor(s/86400)} ngày`};
    async function loadPosts(){if(!profile)return;try{const r=await fetch(`${API}/posts/user?publicId=${encodeURIComponent(profile.publicId)}`,{headers:socialHeaders()});const d=await r.json();if(!d.ok)throw new Error(d.error);$('post-list').innerHTML=d.items.length?d.items.map((p:any)=>`<article class="post-card"><div class="post-head"><b>${esc(p.author.phapdanh)}</b><small>Phẩm ${p.author.rank} · ${ago(p.created)}</small>${p.mine?`<button data-delete="${p.id}">×</button>`:''}</div><p class="post-text">${esc(p.body)}</p><div class="post-actions"><button data-react="${p.id}" class="${p.reacted?'on':''}"> Kết Duyên <span>${p.reactionCount||0}</span></button><button data-replies="${p.id}"> Lời Ghé <span>${p.replyCount||0}</span></button></div><div class="reply-list" id="replies-${p.id}" hidden></div>${token?`<form class="reply-form" data-reply="${p.id}"><input maxlength="1000" placeholder="Ghé một lời…"><button>Gửi</button></form>`:''}</article>`).join(''):'<p class="wall-wait">Bảng còn tĩnh lặng. Hãy gieo lời đầu tiên.</p>';bindSocial()}catch(e:any){$('post-list').innerHTML=`<p class="wall-wait">${esc(e.message)}</p>`}}
    function bindSocial(){document.querySelectorAll('[data-react]').forEach(el=>el.addEventListener('click',async()=>{if(!token)return location.href='/vao-coi';const id=Number((el as HTMLElement).dataset.react);const r=await fetch(`${API}/reaction/toggle`,{method:'POST',headers:{'Content-Type':'application/json',...socialHeaders()},body:JSON.stringify({postId:id})});const d=await r.json();if(d.ok){el.classList.toggle('on',d.active);el.querySelector('span')!.textContent=d.count}}));document.querySelectorAll('[data-replies]').forEach(el=>el.addEventListener('click',()=>loadReplies(Number((el as HTMLElement).dataset.replies))));document.querySelectorAll('[data-reply]').forEach(el=>el.addEventListener('submit',async(e)=>{e.preventDefault();const id=Number((el as HTMLElement).dataset.reply);const input=el.querySelector('input') as HTMLInputElement;if(!input.value.trim())return;const r=await fetch(`${API}/reply/create`,{method:'POST',headers:{'Content-Type':'application/json',...socialHeaders()},body:JSON.stringify({postId:id,body:input.value})});const d=await r.json();if(d.ok){input.value='';loadReplies(id)}}));document.querySelectorAll('[data-delete]').forEach(el=>el.addEventListener('click',async()=>{if(!confirm('Ẩn lời này khỏi Bảng?'))return;await fetch(`${API}/post/delete`,{method:'POST',headers:{'Content-Type':'application/json',...socialHeaders()},body:JSON.stringify({id:Number((el as HTMLElement).dataset.delete)})});loadPosts()}))}
    async function loadReplies(id:number){const box=$(`replies-${id}`);box.hidden=false;const r=await fetch(`${API}/replies?postId=${id}`,{headers:socialHeaders()});const d=await r.json();box.innerHTML=d.ok&&d.items.length?d.items.map((x:any)=>`<p><b>${esc(x.author.phapdanh)}</b> ${esc(x.body)}</p>`).join(''):'<p>Chưa có lời ghé.</p>'}
    $('post-form').addEventListener('submit',async(e)=>{e.preventDefault();const body=$('post-body').value.trim();if(!body)return;$('post-msg').textContent='Đang gieo lời…';const r=await fetch(`${API}/post/create`,{method:'POST',headers:{'Content-Type':'application/json',...socialHeaders()},body:JSON.stringify({body,visibility:$('post-visibility').value,wallPublicId:profile.publicId})});const d=await r.json();$('post-msg').textContent=d.ok?'Đã gieo lời':d.error||'Chưa gieo được';if(d.ok){$('post-body').value='';loadPosts()}});
    const originalRender=render;render=()=>{originalRender();$('post-form').hidden=!token;loadPosts()};
    load();
 </script>
</BaseLayout>
