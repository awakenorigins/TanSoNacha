---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Chuông Duyên — Tần Số Nacha" description="Những tiếng chuông từ các nhân duyên lành."><section class="bell-page"><header><span class="bell-hero-ico"><svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3.2c-3.3 0-5.4 2.3-5.4 5.4v3.1c0 1.6-.7 2.7-1.7 3.7-.4.4-.1 1.1.5 1.1h13.2c.6 0 .9-.7.5-1.1-1-1-1.7-2.1-1.7-3.7V8.6c0-3.1-2.1-5.4-5.4-5.4z"/><path d="M10 19.6a2 2 0 0 0 4 0"/></svg></span><p>緣 鐘</p><h1>Chuông Duyên</h1><button id="read-all">Đã lắng nghe tất cả</button></header><main id="bell-list"><p class="state">Đang nghe tiếng chuông…</p></main></section><style>.bell-page{min-height:100vh;background:radial-gradient(circle at 50% 0,rgba(201,169,110,.18),transparent 32%),#100f0e;color:#f5f0eb;padding:4rem 1rem 7rem}.bell-page header{text-align:center;max-width:680px;margin:auto}.bell-page header>span{font-size:3rem}.bell-hero-ico{display:inline-grid;place-items:center;color:#c9a96e}.bell-hero-ico svg{width:1em;height:1em}.bell-page header p{font-size:.65rem;letter-spacing:.45em;color:#c9a96e}.bell-page h1{font:700 2.5rem 'Playfair Display',serif}.bell-page button{margin:.7rem 0 1.5rem;border:1px solid rgba(201,169,110,.35);border-radius:99px;padding:.45rem .8rem;color:#d8bd89}#bell-list{max-width:680px;margin:auto;display:grid;gap:.55rem}.bell{display:flex;gap:.8rem;align-items:center;padding:.9rem 1rem;border:1px solid rgba(201,169,110,.18);border-radius:16px;background:rgba(245,240,235,.04)}.bell.unread{background:rgba(201,169,110,.1);border-color:rgba(201,169,110,.35)}.av{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#765736;font-weight:700}.bell div:nth-child(2){flex:1}.bell p{font-size:.83rem}.bell small{font-size:.65rem;color:rgba(245,240,235,.4)}.state{text-align:center;color:#c9a96e;padding:3rem}</style><script>const API='/pp-api';const list=document.getElementById('bell-list')!;let token='';try{token=localStorage.getItem('pp-token')||''}catch{}const esc=(s:string)=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));const ago=(ts:number)=>{const s=Math.max(0,Math.floor((Date.now()-ts)/1000));return s<60?'vừa xong':s<3600?`${Math.floor(s/60)} phút`:s<86400?`${Math.floor(s/3600)} giờ`:`${Math.floor(s/86400)} ngày`};async function load(){if(!token){location.href='/vao-coi';return}const r=await fetch(`${API}/notifications?limit=50`,{headers:{'X-PP-Token':token}});const d=await r.json();list.innerHTML=d.ok&&d.items.length?d.items.map((n:any)=>`<article class="bell ${n.read?'':'unread'}"><div class="av">${esc((n.actor?.phapdanh||'鐘').slice(0,1))}</div><div><p>${esc(n.text)}</p><small>${ago(n.created)}</small></div></article>`).join(''):'<p class="state">Chuông đang tĩnh. Khi duyên chạm tới, tiếng chuông sẽ ngân nơi đây.</p>'}document.getElementById('read-all')!.addEventListener('click',async()=>{await fetch(`${API}/notifications/mark-read`,{method:'POST',headers:{'Content-Type':'application/json','X-PP-Token':token},body:'{}'});load();document.querySelectorAll('[data-social-badge]').forEach((e:any)=>e.hidden=true)});load();</script></BaseLayout>
