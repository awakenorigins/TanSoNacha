    .nacha-share-btn:hover { transform: translateY(-2px); filter: brightness(1.15); }
    .nacha-share-fb { background: rgba(59,89,152,0.28); border-color: rgba(89,119,192,0.5); }
    .nacha-share-tt { background: rgba(255,0,80,0.14); border-color: rgba(255,80,120,0.4); }
    .nacha-share-note { margin-top: 0.9rem; font-size: 0.78rem; color: #C9A66B; text-align: center; }

    @media (max-width: 480px) {
      .nacha-act-label { font-size: 0.56rem; }
      .nacha-emoji-pop { width: 13rem; grid-template-columns: repeat(7, 1fr); }
    }
 </style>

  <!-- ═══════════════ PLAYER LOGIC ═══════════════ -->
  <script>
    const audio = document.getElementById('nacha-audio') as HTMLAudioElement | null;
    const playBtn = document.getElementById('nacha-play');
    const iconPlay = document.getElementById('nacha-icon-play');
    const iconPause = document.getElementById('nacha-icon-pause');
    const vinyl = document.getElementById('nacha-vinyl');
    const seek = document.getElementById('nacha-seek');
    const fill = document.getElementById('nacha-seek-fill');
    const curEl = document.getElementById('nacha-cur');
    const durEl = document.getElementById('nacha-dur');
    const back = document.getElementById('nacha-back');
    const fwd = document.getElementById('nacha-fwd');
    const lyricsBox = document.getElementById('nacha-lyrics');
    const lines = Array.from(document.querySelectorAll('.nacha-line')) as HTMLElement[];
    const listPlay = document.querySelector('.nacha-list-play');

    function fmt(s: number): string {
      if (!isFinite(s)) return '0:00';
      const m = Math.floor(s / 60);
      const ss = Math.floor(s % 60).toString().padStart(2, '0');
      return `${m}:${ss}`;
    }

    function setPlaying(on: boolean) {
      iconPlay?.classList.toggle('hidden', on);
      iconPause?.classList.toggle('hidden', !on);
      vinyl?.classList.toggle('spinning', on);
    }

    function toggle() {
      if (!audio) return;
      if (audio.paused) audio.play(); else audio.pause();
    }

    playBtn?.addEventListener('click', toggle);
    listPlay?.addEventListener('click', () => {
      if (!audio) return;
      audio.play();
      document.getElementById('nacha-play')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    const tapBtn = document.getElementById('nacha-tap');

    audio?.addEventListener('play', () => { setPlaying(true); tapBtn?.classList.add('hidden'); });
    audio?.addEventListener('pause', () => setPlaying(false));
    audio?.addEventListener('ended', () => { setPlaying(false); if (fill) fill.style.width = '0%'; });

    // ── Auto-play on page load ──
    // Browsers block audible autoplay until a user gesture. Try to play;
    // if blocked, reveal a tap hint and start on the first interaction anywhere.
    function tryAutoplay() {
      if (!audio) return;
      const p = audio.play();
      if (p && typeof p.then === 'function') {
        p.then(() => {
          tapBtn?.classList.add('hidden');
        }).catch(() => {
          // autoplay blocked → show hint + arm one-time gesture
          tapBtn?.classList.remove('hidden');
          const kick = () => {
            audio.play().then(() => tapBtn?.classList.add('hidden')).catch(() => {});
            document.removeEventListener('pointerdown', kick);
            document.removeEventListener('keydown', kick);
            document.removeEventListener('touchstart', kick);
          };
          document.addEventListener('pointerdown', kick, { once: true });
          document.addEventListener('touchstart', kick, { once: true });
          document.addEventListener('keydown', kick, { once: true });
        });
      }
    }
    tapBtn?.addEventListener('click', (e) => { e.stopPropagation(); audio?.play(); });
    // fire once audio is ready enough to play
    if (audio) {
      if (audio.readyState >= 2) tryAutoplay();
      else audio.addEventListener('canplay', tryAutoplay, { once: true });
    }

    audio?.addEventListener('loadedmetadata', () => {
      if (durEl && audio) durEl.textContent = fmt(audio.duration);
    });

    back?.addEventListener('click', () => { if (audio) audio.currentTime = Math.max(0, audio.currentTime - 10); });
    fwd?.addEventListener('click', () => { if (audio) audio.currentTime = Math.min(audio.duration || 0, audio.currentTime + 10); });

    seek?.addEventListener('click', (e) => {
      if (!audio || !seek) return;
      const rect = (seek as HTMLElement).getBoundingClientRect();
      const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
      audio.currentTime = ratio * (audio.duration || 0);
    });

    let activeIdx = -1;
    audio?.addEventListener('timeupdate', () => {
      if (!audio) return;
      const t = audio.currentTime;
      if (fill && audio.duration) fill.style.width = `${(t / audio.duration) * 100}%`;
      if (curEl) curEl.textContent = fmt(t);

      // find current lyric line
      let idx = -1;
      for (let i = 0; i < lines.length; i++) {
        const lt = parseFloat(lines[i].dataset.t || '0');
        if (t + 0.35 >= lt) idx = i; else break;
      }
      if (idx !== activeIdx) {
        lines.forEach((el, i) => {
          el.classList.toggle('active', i === idx);
          el.classList.toggle('passed', i < idx);
        });
        activeIdx = idx;
        const el = lines[idx];
        if (el && lyricsBox) {
          const target = el.offsetTop - lyricsBox.clientHeight / 2 + el.clientHeight / 2;
          lyricsBox.scrollTo({ top: target, behavior: 'smooth' });
        }
      }
    });

    // keyboard: space to play/pause when page focused (avoid when typing)
    document.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && !(e.target as HTMLElement)?.closest('input,textarea,button,a')) {
        e.preventDefault(); toggle();
      }
    });

    // ═══════════ TƯƠNG TÁC PUBLIC (API backend trên VPS) ═══════════
    const API = '/api';
    const actionsWrap = document.querySelector('.nacha-actions') as HTMLElement | null;
    const TRACK = actionsWrap?.dataset.track || 'da-nam-mo';
    const numEls = Array.from(document.querySelectorAll('[data-num]')) as HTMLElement[];
    const SHARE_TEXT_DEFAULT = (document.getElementById('nacha-share-text') as HTMLTextAreaElement | null)?.value || '';
    const SHARE_LINK = 'https://tangkinhcac.62.146.238.213.sslip.io/nacha';

    function fmtNum(n: number): string {
      if (n >= 1000000) return (n / 1000000).toFixed(1).replace('.0','') + 'M';
      if (n >= 1000) return (n / 1000).toFixed(1).replace('.0','') + 'K';
      return String(n);
    }
    function paint(stats: any) {
      if (!stats) return;
      numEls.forEach((el) => {
        const k = el.dataset.num!;
        if (k in stats) el.textContent = fmtNum(stats[k]);
      });
    }
    async function loadStats() {
      try {
        const r = await fetch(`${API}/stats?track=${encodeURIComponent(TRACK)}`);
        const d = await r.json();
        if (d.ok) { paint(d.stats); paintReactions(d.stats); }
      } catch {}
    }

    // localStorage: nhớ người này đã Kính/Like chưa (UI state; số thật vẫn ở server)
    function already(metric: string): boolean {
      try { return localStorage.getItem(`nacha-${TRACK}-${metric}`) === '1'; } catch { return false; }
    }
    function mark(metric: string) {
      try { localStorage.setItem(`nacha-${TRACK}-${metric}`, '1'); } catch {}
    }

    async function hit(metric: string) {
      try {
        const r = await fetch(`${API}/hit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ track: TRACK, metric }),
        });
        const d = await r.json();
        if (d.stats) { paint(d.stats); paintReactions(d.stats); }
      } catch {}
    }

    function floatEmoji(x: number, y: number, emoji: string) {
      const s = document.createElement('span');
      s.className = 'nacha-float'; s.textContent = emoji;
      s.style.left = x + 'px'; s.style.top = y + 'px';
      document.body.appendChild(s);
      setTimeout(() => s.remove(), 1100);
    }

    // ══ REACTION: nút Kính chính + đè (long-press/hover) hiện tray chọn cảm xúc ══
    const REACT_EMOJI: Record<string,string> = { kinh:'', like:'', sen:'', sang:'', tue:'', tym:'' };
    const REACT_LABEL: Record<string,string> = { kinh:'Kính', like:'Thích', sen:'Sen', sang:'Hào quang', tue:'An lạc', tym:'Thương' };
    const reactWrap = document.querySelector('.nacha-react-wrap') as HTMLElement | null;
    const reactMain = document.querySelector('.nacha-react-main') as HTMLElement | null;
    const reactTray = document.querySelector('.nacha-react-tray') as HTMLElement | null;
    const reactIco = document.querySelector('[data-react-ico]') as HTMLElement | null;
    const reactLabelEl = document.querySelector('[data-react-label]') as HTMLElement | null;
    let longPressTimer: any = null;
    let trayOpenedByHold = false;

    function showTray() { if (reactTray) reactTray.hidden = false; }
    function hideTray() { if (reactTray) reactTray.hidden = true; }

    function doReact(metric: string, srcEl?: HTMLElement) {
      const el = srcEl || reactMain;
      if (el) {
        const rect = el.getBoundingClientRect();
        floatEmoji(rect.left + rect.width / 2 - 12, rect.top, REACT_EMOJI[metric] || '');
      }
      // đổi icon nút chính theo reaction vừa chọn
      if (reactIco) reactIco.textContent = REACT_EMOJI[metric] || '';
      if (reactLabelEl) reactLabelEl.textContent = REACT_LABEL[metric] || 'Kính';
      reactMain?.classList.remove('pulsed'); void reactMain?.offsetWidth; reactMain?.classList.add('pulsed');
      try { localStorage.setItem(`nacha-${TRACK}-lastreact`, metric); } catch {}
      hit(metric);
    }

    // click nhanh = reaction mặc định (Kính, hoặc reaction lần trước)
    reactMain?.addEventListener('click', (e) => {
      if (trayOpenedByHold) { trayOpenedByHold = false; return; } // vừa long-press thì không bắn click
      let last = 'kinh';
      try { last = localStorage.getItem(`nacha-${TRACK}-lastreact`) || 'kinh'; } catch {}
      doReact(last, reactMain!);
    });

    // long-press (mobile) + hover (desktop) để mở tray
    reactMain?.addEventListener('pointerdown', () => {
      longPressTimer = setTimeout(() => { trayOpenedByHold = true; showTray(); }, 380);
    });
    const cancelHold = () => { if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; } };
    reactMain?.addEventListener('pointerup', cancelHold);
    reactMain?.addEventListener('pointerleave', cancelHold);
    reactWrap?.addEventListener('mouseenter', showTray);
    reactWrap?.addEventListener('mouseleave', hideTray);
    document.addEventListener('click', (e) => {
      if (reactTray && !reactTray.hidden && !(e.target as HTMLElement).closest('.nacha-react-wrap')) hideTray();
    });

    // chọn 1 reaction trong tray
    reactTray?.querySelectorAll('button[data-react]').forEach((b) => {
      b.addEventListener('click', (e) => {
        e.stopPropagation();
        const metric = (b as HTMLElement).dataset.react!;
        doReact(metric, b as HTMLElement);
        hideTray();
      });
    });

    // paint số từng loại reaction trong tray + nút chính
    function paintReactions(stats: any) {
      if (!stats) return;
      document.querySelectorAll('[data-rnum]').forEach((el) => {
        const k = (el as HTMLElement).dataset.rnum!;
        if (k in stats) el.textContent = fmtNum(stats[k]);
      });
    }

    // ══ LƯỢT NGHE: chỉ tính khi nghe > 3s (1 lần/phiên) ══
    let playCounted = false;
    let listenAccum = 0; // giây đã nghe thực
    let lastTs = 0;
    audio?.addEventListener('play', () => { lastTs = Date.now(); });
    audio?.addEventListener('pause', () => { if (lastTs) { listenAccum += (Date.now() - lastTs) / 1000; lastTs = 0; } });
    audio?.addEventListener('timeupdate', () => {
      if (playCounted || audio!.paused) return;
      const now = Date.now();
      const elapsed = lastTs ? listenAccum + (now - lastTs) / 1000 : listenAccum;
      if (elapsed >= 3) { playCounted = true; hit('play'); }
    });

    // ══ COMMENTS ══
    const cList = document.getElementById('nacha-clist');
    const cName = document.getElementById('nacha-cname') as HTMLInputElement | null;
    const cBody = document.getElementById('nacha-cbody') as HTMLTextAreaElement | null;
    const cSend = document.getElementById('nacha-csend') as HTMLButtonElement | null;
    const cMsg = document.getElementById('nacha-cmsg') as HTMLElement | null;
    const replyHint = document.getElementById('nacha-reply-hint');
    const replyToLabel = document.getElementById('nacha-reply-to');
    const replyCancel = document.getElementById('nacha-reply-cancel');
    let replyTo = 0;
    function clearReply() { replyTo = 0; replyHint?.classList.remove('show'); }
    replyCancel?.addEventListener('click', clearReply);

    function timeAgo(ts: number): string {
      const s = Math.floor((Date.now() - ts) / 1000);
      if (s < 60) return 'vừa xong';
      if (s < 3600) return Math.floor(s / 60) + ' phút trước';
      if (s < 86400) return Math.floor(s / 3600) + ' giờ trước';
      return Math.floor(s / 86400) + ' ngày trước';
    }
    function esc(s: string): string {
      return s.replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] as string));
    }
    function itemHtml(c: any, isReply: boolean): string {
      return `
        <div class="nacha-citem" data-cid="${c.id}">
          <div class="nacha-citem-head">
            <span class="nacha-citem-name">${esc(c.name)}</span>
            <span class="nacha-citem-time">${timeAgo(c.ts)}</span>
         </div>
          <div class="nacha-citem-body">${esc(c.body)}</div>
          ${isReply ? '' : `<span class="nacha-citem-reply" data-reply-id="${c.id}" data-reply-name="${esc(c.name)}">↩ Trả lời</span>`}
       </div>`;
    }
    function renderComments(rows: any[]) {
      if (!cList) return;
      if (!rows || rows.length === 0) {
        cList.innerHTML = '<p class="nacha-cempty text-center text-parchment/45 text-sm py-6">Chưa có lời bình nào — hãy là người đầu tiên gửi lời kính </p>';
        bindReplyBtns(); return;
      }
      // gốc (parent=0) trước, mỗi gốc kèm các reply của nó
      const roots = rows.filter((c) => !c.parent);
      const byParent: Record<string, any[]> = {};
      rows.filter((c) => c.parent).forEach((c) => { (byParent[c.parent] ||= []).push(c); });
      cList.innerHTML = roots.map((root) => {
        const replies = byParent[root.id] || [];
        const rHtml = replies.length
          ? `<div class="nacha-creplies">${replies.map((r) => itemHtml(r, true)).join('')}</div>` : '';
        return itemHtml(root, false) + rHtml;
      }).join('');
      bindReplyBtns();
    }
    function bindReplyBtns() {
      cList?.querySelectorAll('.nacha-citem-reply').forEach((el) => {
        el.addEventListener('click', () => {
          replyTo = parseInt((el as HTMLElement).dataset.replyId || '0', 10) || 0;
          const nm = (el as HTMLElement).dataset.replyName || '';
          if (replyHint && replyToLabel) { replyHint.classList.add('show'); replyToLabel.textContent = `↩ Đang trả lời ${nm}`; }
          document.getElementById('nacha-comments-sec')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          setTimeout(() => cBody?.focus(), 400);
        });
      });
    }
    async function loadComments() {
      try {
        const r = await fetch(`${API}/comments?track=${encodeURIComponent(TRACK)}&limit=500`);
        const d = await r.json();
        if (d.ok) renderComments(d.comments);
      } catch {}
    }

    cSend?.addEventListener('click', async () => {
      const body = (cBody?.value || '').trim();
      if (!body) { if (cMsg) { cMsg.hidden = false; cMsg.className = 'nacha-cmsg err'; cMsg.textContent = 'Xin viết ít lời trước khi gửi.'; } return; }
      cSend.disabled = true;
      try {
        const r = await fetch(`${API}/comment`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ track: TRACK, name: (cName?.value || '').trim(), body, parent: replyTo }),
        });
        const d = await r.json();
        if (d.ok) {
          renderComments(d.comments); paint(d.stats); paintReactions(d.stats);
          if (cBody) cBody.value = '';
          clearReply();
          if (cMsg) { cMsg.hidden = false; cMsg.className = 'nacha-cmsg'; cMsg.textContent = 'Cảm ơn lời kính của bạn '; }
        } else if (cMsg) {
          cMsg.hidden = false; cMsg.className = 'nacha-cmsg err'; cMsg.textContent = d.error || 'Có lỗi, xin thử lại.';
        }
      } catch {
        if (cMsg) { cMsg.hidden = false; cMsg.className = 'nacha-cmsg err'; cMsg.textContent = 'Không gửi được, kiểm tra mạng.'; }
      } finally { cSend.disabled = false; setTimeout(() => { if (cMsg) cMsg.hidden = true; }, 4000); }
    });

    // emoji picker cho comment
    const emojiToggle = document.querySelector('.nacha-emoji-toggle');
    const emojiPop = document.querySelector('.nacha-emoji-pop') as HTMLElement | null;
    emojiToggle?.addEventListener('click', (e) => { e.stopPropagation(); if (emojiPop) emojiPop.hidden = !emojiPop.hidden; });
    emojiPop?.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        if (cBody) { cBody.value += b.textContent; cBody.focus(); }
        if (emojiPop) emojiPop.hidden = true;
      });
    });
    document.addEventListener('click', (e) => {
      if (emojiPop && !emojiPop.hidden && !(e.target as HTMLElement).closest('.nacha-emoji-bar')) emojiPop.hidden = true;
    });

    // scroll tới khu comment khi bấm nút Bình
    document.querySelector('.nacha-act[data-act="comment"]')?.addEventListener('click', () => {
      document.getElementById('nacha-comments-sec')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => cBody?.focus(), 500);
    });

    // ══ HOẰNG DƯƠNG (share modal) ══
    const shareModal = document.getElementById('nacha-share-modal');
    const shareText = document.getElementById('nacha-share-text') as HTMLTextAreaElement | null;
    const shareNote = document.getElementById('nacha-share-note') as HTMLElement | null;

    function openShare() {
      if (shareModal) { shareModal.hidden = false; document.body.style.overflow = 'hidden'; }
    }
    function closeShare() {
      if (shareModal) { shareModal.hidden = true; document.body.style.overflow = ''; if (shareNote) shareNote.hidden = true; }
    }
    document.querySelector('.nacha-act[data-act="share"]')?.addEventListener('click', openShare);
    shareModal?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', closeShare));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && shareModal && !shareModal.hidden) closeShare(); });

    function noteShare(msg: string) {
      if (shareNote) { shareNote.hidden = false; shareNote.textContent = msg; }
    }

    shareModal?.querySelectorAll('[data-share]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const kind = (btn as HTMLElement).dataset.share!;
        const text = shareText?.value || SHARE_TEXT_DEFAULT;
        if (kind === 'facebook') {
          // Facebook share dialog: quote + url (u không nhận text dài nên gữi cả quote)
          const u = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(SHARE_LINK)}&quote=${encodeURIComponent(text)}`;
          window.open(u, '_blank', 'noopener,width=680,height=640');
          noteShare('Đã mở cửa sổ Facebook — bấm Đăng để hoằng dương pháp âm ');
        } else if (kind === 'tiktok') {
          // TikTok không có web share đăng bài — chép nội dung + mở tiktok upload
          try { await navigator.clipboard.writeText(text); } catch {}
          window.open('https://www.tiktok.com/upload', '_blank', 'noopener');
          noteShare('Đã chép nội dung + mở TikTok. Dán vào phần mô tả khi đăng video nhé.');
        } else if (kind === 'copy') {
          try { await navigator.clipboard.writeText(text); noteShare('Đã chép nội dung — dán đi muôn nơi '); }
          catch { noteShare('Không chép được, xin chọn và copy tay.'); }
        } else if (kind === 'native') {
          if ((navigator as any).share) {
            try { await (navigator as any).share({ title: 'Tần Số Nacha — Âm Kinh', text, url: SHARE_LINK }); }
            catch {}
          } else {
            try { await navigator.clipboard.writeText(text); noteShare('Thiết bị không hỗ trợ chia sẻ nhanh — đã chép nội dung thay.'); }
            catch { noteShare('Thiết bị không hỗ trợ chia sẻ nhanh.'); }
          }
        }
      });
    });

    // khởi động: nạp số + comment thật từ server; refresh nhẹ mỗi 25s
    loadStats(); loadComments();
    setInterval(loadStats, 25000);
 </script>
</BaseLayout>
