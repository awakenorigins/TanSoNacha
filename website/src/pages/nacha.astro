        <p class="font-accent italic text-ink-light/70 max-w-xl mx-auto mt-4">
          Bộ sưu tập bắt đầu — mỗi tuần thêm một bài, giữ chốn này luôn có tiếng kinh.
       </p>
     </div>

      <div class="space-y-3 mt-8" data-animate="fade-up">
        {tracks.map((t, i) => (
          <div class="flex items-center gap-4 p-4 rounded-xl bg-parchment-warm border border-bronze/10 hover:border-bronze/30 transition-all duration-300">
            <span class="font-chinese text-bronze/50 text-lg w-6 text-center flex-shrink-0">{i + 1}</span>
