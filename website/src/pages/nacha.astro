---

<BaseLayout
  title="Âm Kinh 音經 — Tần Số Nacha"
  description="Tần Số Nacha — Âm Kinh: nơi lưu giữ các bài hát về Phật. Nghe miễn phí, tải tự do. Khởi đầu với Lofi Âm Kinh."
>
  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="relative min-h-[62vh] flex items-center justify-center overflow-hidden -mt-16 md:-mt-20">
    <div class="absolute inset-0 bg-ink">
      <img src="/images/art/img-07-wide.jpg" alt="Tần Số Nacha" class="w-full h-full object-cover opacity-40" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-ink/92 via-ink/70 to-ink"></div>
      <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 40%, rgba(201,166,107,0.16) 0%, transparent 60%);"></div>
   </div>

    <!-- floating sound rings -->
    <div class="nacha-rings" aria-hidden="true">
      <span></span><span></span><span></span>
   </div>

    <div class="relative z-10 text-center px-4 max-w-3xl mx-auto pt-16">
      <p class="font-brush text-bronze-light text-2xl md:text-3xl tracking-[0.4em] mb-5" data-animate="fade-in">那 迦 頻</p>
      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl text-parchment font-bold mb-5" data-animate="fade-up">Tần Số Nacha</h1>
      <p class="font-accent italic text-parchment/85 text-lg md:text-2xl mb-4" data-animate="fade-up">
        Âm Kinh — nơi lời Phật hoá thành thanh âm.
     </p>
      <p class="text-parchment/60 text-sm md:text-base max-w-xl mx-auto" data-animate="fade-up">
        Tất cả mọi người đều có thể vào nghe, tải về tự do. Nhặt một câu kinh, một chữ tâm — rơi vào tim con.
     </p>
   </div>
 </section>

  <!-- ═══════════════ CATEGORY TABS ═══════════════ -->
  <section class="bg-ink border-t border-bronze/15 relative z-20">
    <div class="container-content py-8">
      <div class="text-center mb-8" data-animate="fade-up">
        <span class="font-chinese text-bronze-light text-sm tracking-[0.3em] block mb-1">音 經 分 類</span>
        <h2 class="font-display text-2xl md:text-3xl text-parchment">Phân Loại Âm Kinh</h2>
     </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {categories.map((c) => (
          <button
            class={`nacha-cat text-left rounded-xl p-5 border transition-all duration-300 ${c.active ? 'nacha-cat--active' : 'nacha-cat--soon'}`}
            data-cat={c.id}
            disabled={!c.active}
          >
            <p class="font-brush text-bronze-light text-xl tracking-widest mb-2">{c.cn}</p>
            <h3 class="font-display text-lg text-parchment mb-1">{c.label}</h3>
            <p class="text-xs text-parchment/55 leading-relaxed">{c.desc}</p>
            {!c.active && <span class="inline-block mt-3 text-[10px] uppercase tracking-widest text-bronze-light/70 border border-bronze-light/30 rounded-full px-2 py-0.5">Sắp mở</span>}
         </button>
        ))}
     </div>
   </div>
 </section>

  <!-- ═══════════════ NOW PLAYING — ÂM KINH PLAYER ═══════════════ -->
  <section class="section-dark relative overflow-hidden">
    <div class="absolute inset-0 opacity-30" style="background: radial-gradient(circle at 20% 20%, rgba(201,166,107,0.22), transparent 55%), radial-gradient(circle at 85% 75%, rgba(74,107,92,0.18), transparent 55%);"></div>

    <div class="container-content relative py-14 md:py-20">
      <div class="text-center mb-10" data-animate="fade-up">
        <span class="eyebrow text-bronze-light">正 在 播 放</span>
        <h2 class="font-display text-3xl md:text-4xl text-parchment mt-1">Âm Kinh đang phát</h2>
        <div class="divider-ornament mt-5 max-w-md mx-auto"><span style="color:#C9A66B">低 音 音 經</span></div>
     </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 max-w-5xl mx-auto items-start">

        <!-- LEFT: cover + controls -->
        <div class="flex flex-col items-center" data-animate="fade-up">
          <div class="nacha-cover-wrap relative w-64 h-64 md:w-80 md:h-80">
            <div id="nacha-vinyl" class="nacha-vinyl">
              <img src={song.cover} alt={song.title} class="w-full h-full object-cover rounded-full" />
              <span class="nacha-vinyl-hole"></span>
           </div>
            <div class="nacha-glow" aria-hidden="true"></div>
         </div>

          <p class="font-brush text-bronze-light text-2xl tracking-widest mt-8 mb-1">{song.cn}</p>
          <h3 class="font-display text-xl md:text-2xl text-parchment text-center px-4">{song.title}</h3>
          <p class="text-parchment/60 text-sm mt-1">Tác giả: <span class="text-bronze-light">{song.author}</span></p>
          <span class="tag-bronze mt-3 !bg-bronze/15 !text-bronze-light !border-bronze-light/25">{song.tag}</span>

          <!-- audio element (autoplay attempt on load) -->
          <audio id="nacha-audio" preload="auto" autoplay src={song.src}></audio>

          <!-- tap-to-play hint (shown only if browser blocks autoplay) -->
          <button id="nacha-tap" class="nacha-tap hidden" aria-label="Chạm để phát Âm Kinh">
            <span class="nacha-tap-ring"></span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            <span class="nacha-tap-text">Chạm để nghe Âm Kinh</span>
         </button>

          <!-- progress -->
          <div class="w-full max-w-sm mt-8">
            <div id="nacha-seek" class="nacha-seek">
              <div id="nacha-seek-fill" class="nacha-seek-fill"></div>
           </div>
            <div class="flex justify-between text-xs text-parchment/50 mt-2 font-body">
              <span id="nacha-cur">0:00</span>
              <span id="nacha-dur">{song.duration}</span>
           </div>
         </div>

          <!-- controls -->
          <div class="flex items-center gap-6 mt-6">
            <button id="nacha-back" class="nacha-ctrl-mini" aria-label="Tua lại 10 giây">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
           </button>
            <button id="nacha-play" class="nacha-play" aria-label="Phát / Dừng">
              <svg id="nacha-icon-play" class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="nacha-icon-pause" class="w-8 h-8 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
           </button>
            <button id="nacha-fwd" class="nacha-ctrl-mini" aria-label="Tua tới 10 giây">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 5l7 7-7 7M5 5l7 7-7 7"/></svg>
           </button>
         </div>

          <!-- download (free) -->
          <a href={song.src} download="Da-Nam-Mo-Bon-Su-Thich-Ca-Mau-Ni-Phat.mp3" class="btn-secondary mt-8 !text-parchment !border-parchment/50 hover:!bg-parchment hover:!text-ink text-sm">
            ⤓ Tải về tự do
         </a>

          <!-- ══ TƯƠNG TÁC: Kính(reaction) · Hoằng Dương · Comment · Lượt nghe (public) ══ -->
          <div class="nacha-actions w-full max-w-sm mt-9" data-track={song.id}>
            <div class="grid grid-cols-3 gap-2">
              <!-- Kính = reaction chính, đè (long-press / hover) để chọn cảm xúc khác -->
              <div class="nacha-react-wrap">
                <button class="nacha-act nacha-react-main" data-act="react" aria-label="Kính — đè để chọn cảm xúc">
                  <span class="nacha-act-ico" data-react-ico></span>
                  <span class="nacha-act-label" data-react-label>Kính</span>
                  <span class="nacha-act-num" data-num="react">0</span>
               </button>
                <!-- bảng chọn reaction (đè mới hiện) -->
                <div class="nacha-react-tray" hidden>
                  <button data-react="kinh" title="Kính"><span></span><em data-rnum="kinh">0</em></button>
                  <button data-react="like" title="Thích"><span></span><em data-rnum="like">0</em></button>
                  <button data-react="sen" title="Sen"><span></span><em data-rnum="sen">0</em></button>
                  <button data-react="sang" title="Hào quang"><span></span><em data-rnum="sang">0</em></button>
                  <button data-react="tue" title="An lạc"><span></span><em data-rnum="tue">0</em></button>
                  <button data-react="tym" title="Thương"><span></span><em data-rnum="tym">0</em></button>
               </div>
             </div>
              <!-- Hoằng Dương (share) -->
              <button class="nacha-act" data-act="share" aria-label="Hoằng Dương — chia sẻ">
                <span class="nacha-act-ico"></span>
                <span class="nacha-act-label">Hoằng Dương</span>
                <span class="nacha-act-num nacha-act-num--muted">Share</span>
             </button>
              <!-- Comment -->
              <button class="nacha-act" data-act="comment" aria-label="Bình luận">
                <span class="nacha-act-ico"></span>
                <span class="nacha-act-label">Bình</span>
                <span class="nacha-act-num" data-num="comment">0</span>
             </button>
           </div>
            <!-- lượt nghe public -->
            <p class="text-center text-xs text-parchment/55 mt-4">
              <span class="nacha-listen-ico"></span>
              <span class="text-bronze-light font-semibold" data-num="play">0</span> lượt nghe · cùng chung tứ chúng
           </p>
         </div>
       </div>

        <!-- RIGHT: auto-scroll lyrics -->
        <div data-animate="fade-up">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-bronze-light animate-pulse"></span>
            <span class="font-chinese text-bronze-light text-sm tracking-widest">歌 詞 · Lyric tự chạy</span>
         </div>
          <div id="nacha-lyrics" class="nacha-lyrics">
            {lyrics.map((l, i) => (
              <p class="nacha-line" data-t={l.t} data-i={i}>{l.text}</p>
            ))}
         </div>
       </div>

     </div>
   </div>

    <!-- lyric data for JS -->
    <script type="application/json" id="nacha-lyric-data" set:html={JSON.stringify(lyrics)}></script>
 </section>

  <!-- ═══════════════ KHU BÌNH LUẬN (PUBLIC) ═══════════════ -->
  <section id="nacha-comments-sec" class="section-dark relative" data-track={song.id}>
    <div class="container-content max-w-2xl relative py-14">
      <div class="text-center mb-8" data-animate="fade-up">
        <span class="eyebrow text-bronze-light">菩 提 留 言</span>
        <h2 class="font-display text-2xl md:text-3xl text-parchment mt-1">Lời đạo hữu — <span data-num="comment">0</span> bình</h2>
