              <p class="text-xs text-ink-light/70">{t.author} · {t.tag}</p>
           </div>
            <span class="text-xs text-ink-light/60 flex-shrink-0">{t.duration}</span>
            {t.ready ? (
              <button class="nacha-list-play flex-shrink-0 w-10 h-10 rounded-full bg-bronze text-parchment flex items-center justify-center hover:bg-bronze-dark transition-colors" aria-label="Phát bài này">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
             </button>
            ) : (
              <span class="text-[10px] uppercase tracking-widest text-bronze/60 flex-shrink-0">Sắp mở</span>
            )}
         </div>
        ))}
     </div>

      <p class="text-center text-xs text-ink-light/50 mt-8">
        Âm Kinh là kho mở — nghe miễn phí, tải tự do. Nếu bạn có bản thu về Phật muốn góp, hãy tìm đến Thủ Các.
     </p>
   </div>
 </section>

  <!-- ═══════════════ PAGE STYLES ═══════════════ -->
  <style is:global>
    /* Category cards */
    .nacha-cat--active {
      background: rgba(201,166,107,0.10);
      border-color: rgba(201,166,107,0.45);
      box-shadow: 0 8px 28px rgba(139,111,46,0.18);
    }
    .nacha-cat--active:hover { transform: translateY(-3px); border-color: rgba(201,166,107,0.75); }
    .nacha-cat--soon {
      background: rgba(242,232,213,0.04);
      border-color: rgba(242,232,213,0.10);
      opacity: 0.72;
      cursor: not-allowed;
    }

    /* Vinyl cover */
    .nacha-cover-wrap { display: grid; place-items: center; }
    .nacha-vinyl {
      position: relative;
      width: 100%; height: 100%;
      border-radius: 9999px;
      padding: 8px;
      background: conic-gradient(from 0deg, #1a1510, #3E2614, #1a1510, #5C4A1F, #1a1510);
      box-shadow: 0 20px 60px rgba(0,0,0,0.55), inset 0 0 0 2px rgba(201,166,107,0.25);
      animation: nacha-spin 22s linear infinite;
      animation-play-state: paused;
    }
    .nacha-vinyl.spinning { animation-play-state: running; }
    .nacha-vinyl img {
      background: #F8F1E0;
      box-shadow: inset 0 0 0 6px rgba(0,0,0,0.4);
    }
    .nacha-vinyl-hole {
      position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
      width: 26px; height: 26px; border-radius: 9999px;
      background: #1F1A14; box-shadow: 0 0 0 4px rgba(201,166,107,0.4);
    }
    .nacha-glow {
      position: absolute; inset: -18%;
      border-radius: 9999px;
      background: radial-gradient(circle, rgba(201,166,107,0.35), transparent 65%);
      filter: blur(22px); z-index: -1;
      animation: nacha-breathe 4s ease-in-out infinite;
    }
    @keyframes nacha-spin { to { transform: rotate(360deg); } }
    @keyframes nacha-breathe { 0%,100% { opacity: 0.5; } 50% { opacity: 0.95; } }

    /* Play controls */
    .nacha-play {
      width: 72px; height: 72px; border-radius: 9999px;
      display: grid; place-items: center;
      color: #F2E8D5; background: #8B6F2E;
      box-shadow: 0 10px 30px rgba(139,111,46,0.5);
      transition: transform .25s ease, background .25s ease;
    }
    .nacha-play:hover { transform: scale(1.06); background: #9c7c34; }
    .nacha-play:active { transform: scale(0.96); }
    .nacha-ctrl-mini {
      color: rgba(242,232,213,0.7);
      transition: color .25s ease, transform .2s ease;
    }
    .nacha-ctrl-mini:hover { color: #C9A66B; transform: scale(1.08); }

    /* Tap-to-play hint (autoplay fallback) */
    .nacha-tap {
      position: relative;
      display: inline-flex; align-items: center; gap: 0.6rem;
      margin-top: 1.5rem;
      padding: 0.6rem 1.3rem;
      border-radius: 9999px;
      color: #1F1A14; background: #C9A66B;
      font-family: 'Inter', sans-serif; font-size: 0.85rem; font-weight: 600;
      box-shadow: 0 8px 24px rgba(201,166,107,0.45);
      animation: nacha-tap-pulse 2s ease-in-out infinite;
    }
    .nacha-tap:hover { background: #d4b47c; }
    .nacha-tap-ring {
      position: absolute; inset: 0; border-radius: 9999px;
      border: 2px solid rgba(201,166,107,0.6);
      animation: nacha-tap-ripple 2s ease-out infinite;
    }
    @keyframes nacha-tap-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.04); } }
    @keyframes nacha-tap-ripple { 0% { transform: scale(1); opacity: 0.7; } 100% { transform: scale(1.4); opacity: 0; } }

    /* Seek bar */
    .nacha-seek {
      position: relative; height: 6px; border-radius: 9999px;
      background: rgba(242,232,213,0.15); cursor: pointer; overflow: hidden;
    }
    .nacha-seek-fill {
      position: absolute; inset: 0; width: 0%;
      background: linear-gradient(90deg, #8B6F2E, #C9A66B);
      border-radius: 9999px; transition: width .12s linear;
    }

    /* Lyrics */
    .nacha-lyrics {
      height: 22rem;
      overflow-y: auto;
      padding: 1.5rem 1rem;
      border-radius: 0.9rem;
      background: rgba(31,26,20,0.55);
      border: 1px solid rgba(201,166,107,0.18);
      scrollbar-width: thin;
      scrollbar-color: rgba(201,166,107,0.4) transparent;
      -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
      mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    }
    .nacha-lyrics::-webkit-scrollbar { width: 5px; }
    .nacha-lyrics::-webkit-scrollbar-thumb { background: rgba(201,166,107,0.4); border-radius: 9999px; }
    .nacha-line {
      font-family: 'Cormorant Garamond', 'Playfair Display', serif;
      font-size: 1.35rem;
      line-height: 1.9;
      text-align: center;
      color: rgba(242,232,213,0.34);
      transition: color .4s ease, transform .4s ease, opacity .4s ease;
      transform: scale(0.97);
    }
    .nacha-line.active {
      color: #F2E8D5;
      transform: scale(1.06);
      text-shadow: 0 0 22px rgba(201,166,107,0.55);
      font-weight: 600;
    }
    .nacha-line.passed { color: rgba(242,232,213,0.22); }

    /* Sound rings in hero */
    .nacha-rings { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
    .nacha-rings span {
      position: absolute; width: 220px; height: 220px; border-radius: 9999px;
      border: 1px solid rgba(201,166,107,0.22);
      animation: nacha-ripple 5s ease-out infinite;
    }
    .nacha-rings span:nth-child(2) { animation-delay: 1.6s; }
    .nacha-rings span:nth-child(3) { animation-delay: 3.2s; }
    @keyframes nacha-ripple {
      0% { transform: scale(0.5); opacity: 0.8; }
      100% { transform: scale(2.6); opacity: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .nacha-vinyl, .nacha-glow, .nacha-rings span { animation: none !important; }
    }
    @media (max-width: 480px) {
      .nacha-line { font-size: 1.15rem; }
      .nacha-lyrics { height: 18rem; }
    }

    /* ══ Action buttons (Kính/Like/Share/Comment) ══ */
    .nacha-act {
      display: flex; flex-direction: column; align-items: center; gap: 2px;
      padding: 0.7rem 0.4rem;
      border-radius: 0.85rem;
      background: rgba(242,232,213,0.05);
      border: 1px solid rgba(201,166,107,0.20);
      color: rgba(242,232,213,0.85);
      transition: transform .2s ease, background .25s ease, border-color .25s ease;
      cursor: pointer;
    }
    .nacha-act:hover { background: rgba(201,166,107,0.14); border-color: rgba(201,166,107,0.5); transform: translateY(-2px); }
    .nacha-act:active { transform: scale(0.94); }
    .nacha-act-ico { font-size: 1.4rem; line-height: 1; }
    .nacha-act-label { font-size: 0.62rem; letter-spacing: 0.02em; color: rgba(242,232,213,0.7); text-align:center; }
    .nacha-act-num { font-size: 0.78rem; font-weight: 700; color: #C9A66B; }
    .nacha-act-num--muted { color: rgba(242,232,213,0.5); font-weight: 500; }
    .nacha-act.pulsed { animation: nacha-pop .5s ease; }
    .nacha-act.done { background: rgba(201,166,107,0.20); border-color: rgba(201,166,107,0.6); }
    @keyframes nacha-pop { 0%{transform:scale(1)} 40%{transform:scale(1.18)} 100%{transform:scale(1)} }

    /* reaction wrap + tray (đè để chọn) */
    .nacha-react-wrap { position: relative; }
    .nacha-react-main { width: 100%; height: 100%; }
    .nacha-react-tray[hidden] { display: none !important; }
    .nacha-react-tray {
      position: absolute; left: 50%; bottom: calc(100% + 8px); transform: translateX(-50%);
      display: flex; gap: 4px; z-index: 40;
      background: #241d15; border: 1px solid rgba(201,166,107,0.4);
      border-radius: 9999px; padding: 6px 8px;
      box-shadow: 0 14px 40px rgba(0,0,0,0.55);
      animation: nacha-tray-in .18s ease;
    }
    @keyframes nacha-tray-in { from { opacity: 0; transform: translateX(-50%) translateY(6px); } to { opacity: 1; transform: translateX(-50%); } }
    .nacha-react-tray button {
      display: flex; flex-direction: column; align-items: center; gap: 0;
      padding: 3px 4px; border-radius: 0.6rem; cursor: pointer;
      transition: transform .15s ease, background .15s ease; min-width: 2rem;
    }
    .nacha-react-tray button:hover { transform: scale(1.25) translateY(-3px); background: rgba(201,166,107,0.18); }
    .nacha-react-tray button span { font-size: 1.5rem; line-height: 1; }
    .nacha-react-tray button em { font-size: 0.62rem; font-style: normal; color: #C9A66B; font-weight: 700; margin-top: 1px; }
    .nacha-float {
      position: fixed; z-index: 60; pointer-events: none;
      font-size: 1.6rem; animation: nacha-rise 1.1s ease-out forwards;
    }
    @keyframes nacha-rise { 0%{opacity:1;transform:translateY(0) scale(1)} 100%{opacity:0;transform:translateY(-70px) scale(1.5)} }

    /* ══ Comment box ══ */
    .nacha-cbox { display: flex; flex-direction: column; gap: 0.6rem; }
    .nacha-cinput-name, .nacha-cinput-body {
      width: 100%; background: rgba(31,26,20,0.6);
      border: 1px solid rgba(201,166,107,0.22); border-radius: 0.7rem;
      color: #F2E8D5; padding: 0.7rem 0.9rem; font-family: 'Inter', sans-serif; font-size: 0.9rem;
      transition: border-color .2s ease;
    }
    .nacha-cinput-name:focus, .nacha-cinput-body:focus { outline: none; border-color: rgba(201,166,107,0.6); }
    .nacha-cinput-name::placeholder, .nacha-cinput-body::placeholder { color: rgba(242,232,213,0.4); }
    .nacha-cinput-wrap { position: relative; }
    .nacha-cinput-body { resize: vertical; min-height: 3.5rem; padding-right: 3rem; }
    .nacha-emoji-bar { position: absolute; right: 0.6rem; bottom: 0.6rem; }
    .nacha-emoji-toggle {
      font-size: 1.15rem; line-height: 1; padding: 0.25rem; border-radius: 0.5rem;
      background: rgba(201,166,107,0.12); cursor: pointer; transition: background .2s;
    }
    .nacha-emoji-toggle:hover { background: rgba(201,166,107,0.28); }
    .nacha-emoji-pop[hidden] { display: none !important; }
    .nacha-emoji-pop {
      position: absolute; right: 0; bottom: 2.4rem; z-index: 30;
      display: grid; grid-template-columns: repeat(8, 1fr); gap: 2px;
