    /* ══ Share modal ══ */
    .nacha-modal { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 1rem; }
    .nacha-modal[hidden] { display: none; }
    .nacha-modal-backdrop { position: absolute; inset: 0; background: rgba(10,8,5,0.78); backdrop-filter: blur(4px); }
