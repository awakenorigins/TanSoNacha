---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="BẢNG NHÂN DUYÊN — Tần Số Nacha" description="Dòng giao cảm của cộng đồng tu học Tần Số Nacha.">
  <section class="feed-page">
    <header data-adaptive-art class="feed-hero">
      <div class="orbit" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7.5"/><circle cx="12" cy="12" r="2.1"/><path d="M12 2.8v18.4M2.8 12h18.4M5.5 5.5l13 13M18.5 5.5l-13 13"/></svg></div>
      <p>眾 緣 和 合</p>
      <h1>BẢNG NHÂN DUYÊN</h1>
      <span>Mỗi lời lành là một tần số. Mỗi cuộc gặp là một nhân duyên.</span>
    </header>
    <main class="feed-wrap">
      <form id="feed-compose" class="compose">
        <label class="compose-lotus" for="feed-body" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 20c-4.2-2.6-6.4-5.9-6.4-10 2.8.7 4.9 2.4 6.4 5 1.5-2.6 3.6-4.3 6.4-5 0 4.1-2.2 7.4-6.4 10Z"/><path d="M12 15c-.8-3.7-.2-6.9 0-9 .2 2.1.8 5.3 0 9Z"/><path d="M3.8 16c2.1 2.9 4.8 4.5 8.2 4.7 3.4-.2 6.1-1.8 8.2-4.7"/></svg>
        </label>
        <textarea id="feed-body" maxlength="4000" rows="3" placeholder="Ghé một lời lành…" required></textarea>
        <div class="compose-foot">
          <select id="feed-vis" aria-label="Chọn phạm vi hiển thị"><option value="members">Người trong cõi</option><option value="public">Mọi người</option><option value="private">Riêng mình</option></select>
          <button aria-label="Gieo lời"><span>Gieo Lời</span><svg class="send-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13.2M13.5 6.8l5.2 5.2-5.2 5.2"/></svg></button>
        </div>
        <p id="feed-msg"></p>
      </form>
      <div id="feed-list"><p class="state">Đang lắng nghe các duyên…</p></div>
      <button id="feed-more" hidden>Xem thêm nhân duyên</button>
    </main>
  </section>

  <style>
    .feed-page{min-height:100vh;background:#100f0e;color:#f5f0eb;padding-bottom:7rem}.feed-hero{text-align:center;padding:5rem 1rem 2.5rem;background:radial-gradient(circle at 50% 15%,rgba(201,169,110,.2),transparent 42%),linear-gradient(#17130f,#100f0e);overflow:hidden}.orbit{width:5rem;height:5rem;color:rgba(201,169,110,.18);animation:spin 35s linear infinite;display:inline-grid;place-items:center;margin:0 auto}.orbit svg{width:100%;height:100%;display:block;stroke:currentColor;stroke-width:1.2;fill:none;stroke-linecap:round;stroke-linejoin:round}.feed-hero p{font-size:.65rem;letter-spacing:.5em;color:#c9a96e}.feed-hero h1{font:700 clamp(2rem,7vw,4rem) 'Playfair Display',serif;letter-spacing:.08em}.feed-hero span{font:italic 1rem serif;color:rgba(245,240,235,.55)}@keyframes spin{to{transform:rotate(360deg)}}.feed-wrap{max-width:720px;margin:auto;padding:0 1rem}.compose,.card{border:1px solid rgba(201,169,110,.22);border-radius:22px;background:rgba(245,240,235,.045);padding:1rem;margin-bottom:.8rem}.compose{position:relative;background:linear-gradient(180deg,rgba(244,231,207,.075),rgba(244,231,207,.035));box-shadow:0 18px 48px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.04)}.compose-lotus{position:absolute;left:1.15rem;top:1.1rem;width:1.25rem;height:1.25rem;color:rgba(201,169,110,.82);pointer-events:none}.compose-lotus svg,.send-ico,.action-ico{stroke:currentColor;stroke-width:1.55;fill:none;stroke-linecap:round;stroke-linejoin:round}.compose textarea{width:100%;background:rgba(244,231,207,.08);border:1px solid rgba(201,169,110,.34);border-radius:20px;color:#fff;outline:0;resize:vertical;line-height:1.65;padding:.9rem 1rem .9rem 2.85rem;min-height:7.2rem}.compose textarea::placeholder{color:rgba(201,169,110,.62)}.compose textarea:focus{border-color:rgba(201,169,110,.76);box-shadow:0 0 0 3px rgba(201,169,110,.14)}.compose-foot{display:flex;justify-content:flex-end;gap:.5rem;border-top:1px solid rgba(201,169,110,.12);padding-top:.7rem}.compose select,.compose button,#feed-more{border:1px solid rgba(201,169,110,.32);border-radius:99px;padding:.48rem .82rem;background:#191714;color:#d8bd89}.compose button{background:#c9a96e;color:#17130f;font-weight:700;display:inline-flex;align-items:center;gap:.38rem;box-shadow:0 8px 22px rgba(201,169,110,.16)}.send-ico{width:1.05em;height:1.05em}.card-head{display:flex;align-items:center;gap:.65rem}.avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#765736;font-weight:700}.who{flex:1}.who a{font-weight:700;color:#eadbbd}.who small{display:block;font-size:.66rem;color:rgba(245,240,235,.4)}.body{white-space:pre-wrap;line-height:1.7;margin:.8rem 0}.actions{display:flex;align-items:center;gap:.55rem;flex-wrap:wrap}.actions button{display:inline-flex;align-items:center;gap:.38rem;border:1px solid rgba(201,169,110,.18);border-radius:99px;padding:.42rem .68rem;color:#d8bd89;font-size:.72rem;line-height:1;background:rgba(244,231,207,.035);transition:border-color .18s ease,background .18s ease,transform .18s ease}.actions button:hover{border-color:rgba(201,169,110,.42);background:rgba(201,169,110,.1)}.actions button.on{background:rgba(201,169,110,.18);border-color:rgba(201,169,110,.42)}.action-ico{width:1.05em;height:1.05em;flex:0 0 auto}.action-count{color:rgba(201,169,110,.86);font-variant-numeric:tabular-nums}.reply-box{margin-top:.7rem}.reply-box p{font-size:.76rem;padding:.45rem .6rem;background:rgba(255,255,255,.035);border-radius:9px;margin:.3rem 0}.reply-form{position:relative;display:flex;align-items:center;margin-top:.7rem;width:100%}.reply-form input{width:100%;min-width:0;border:1px solid rgba(201,169,110,.35);border-radius:999px;background:rgba(244,231,207,.11);color:#fff;padding:.72rem 3rem .72rem 1rem;outline:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.04);transition:border-color .18s ease,box-shadow .18s ease,background .18s ease}.reply-form input::placeholder{color:rgba(201,169,110,.62)}.reply-form input:focus{border-color:rgba(201,169,110,.72);background:rgba(244,231,207,.145);box-shadow:0 0 0 3px rgba(201,169,110,.16),inset 0 1px 0 rgba(255,255,255,.06)}.reply-form button{position:absolute;right:.34rem;top:50%;transform:translateY(-50%);width:2.15rem;height:2.15rem;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(201,169,110,.55);background:rgba(201,169,110,.18);color:#c9a96e;padding:0;transition:background .18s ease,transform .18s ease,color .18s ease}.reply-form button:hover{background:#c9a96e;color:#100b08;transform:translateY(-50%) scale(1.03)}.state{text-align:center;padding:2rem;color:#c9a96e}#feed-more{display:block;margin:1rem auto}#feed-msg{font-size:.72rem;text-align:right;color:#b8c9c0}@media(max-width:480px){.feed-wrap{padding:0 .75rem}.card{padding:.9rem;border-radius:18px}.actions{gap:.42rem}.actions button{font-size:.68rem;padding:.4rem .58rem}.reply-form input{font-size:.95rem;padding-right:2.85rem}.compose-foot{justify-content:space-between}.compose select{min-width:0;max-width:55%}}@media(prefers-reduced-motion:reduce){.orbit{animation:none}.actions button,.reply-form input,.reply-form button{transition:none}}
  </style>

  <script>
    const API='/pp-api';
    const $=(id:string)=>document.getElementById(id)!;
    const esc=(s:string)=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]||c));
    const lotusSvg="<svg class='action-ico' viewBox='0 0 24 24' aria-hidden='true'><path d='M12 19.5c-3.6-2.2-5.5-5-5.5-8.4 2.4.6 4.2 2 5.5 4.2 1.3-2.2 3.1-3.6 5.5-4.2 0 3.4-1.9 6.2-5.5 8.4Z'/><path d='M12 15.3c-.7-3.2-.2-6 0-7.8.2 1.8.7 4.6 0 7.8Z'/><path d='M4.6 15.4c1.8 2.5 4.2 3.9 7.4 4.1 3.2-.2 5.6-1.6 7.4-4.1'/></svg>";
    const chatSvg="<svg class='action-ico' viewBox='0 0 24 24' aria-hidden='true'><path d='M5.2 6.8a7.1 7.1 0 0 1 6.8-3.5c4.2 0 7.6 2.8 7.6 6.4s-3.4 6.4-7.6 6.4c-.8 0-1.7-.1-2.4-.3L5 18.5l1.1-4.1a5.7 5.7 0 0 1-.9-7.6Z'/></svg>";
    const sendSvg="<svg class='send-ico' viewBox='0 0 24 24' aria-hidden='true'><path d='M5 12h13.2M13.5 6.8l5.2 5.2-5.2 5.2'/></svg>";
    let token='';try{token=localStorage.getItem('pp-token')||''}catch{}
    let cursor:any=null;
    const headers=()=>token?{'X-PP-Token':token}:{};
    const ago=(ts:number)=>{const s=Math.max(0,Math.floor((Date.now()-ts)/1000));return s<60?'vừa xong':s<3600?`${Math.floor(s/60)} phút trước`:s<86400?`${Math.floor(s/3600)} giờ trước`:`${Math.floor(s/86400)} ngày trước`};
    function card(p:any){return `<article class="card"><div class="card-head"><div class="avatar">${esc(p.author.phapdanh.slice(0,1))}</div><div class="who"><a href="/nguoi?id=${encodeURIComponent(p.author.publicId)}">${esc(p.author.phapdanh)}</a><small>Phẩm ${p.author.rank} · ${ago(p.created)}</small></div></div><p class="body">${esc(p.body)}</p><div class="actions"><button data-like="${p.id}" class="${p.reacted?'on':''}">${lotusSvg} Kết Duyên <span class="action-count">${p.reactionCount||0}</span></button><button data-show="${p.id}">${chatSvg} Lời Ghé <span class="action-count">${p.replyCount||0}</span></button></div><div class="reply-box" id="rb-${p.id}" hidden></div>${token?`<form class="reply-form" data-rf="${p.id}"><input maxlength="1000" placeholder="Ghé một lời lành…"><button aria-label="Gửi lời ghé">${sendSvg}</button></form>`:''}</article>`}
    async function load(reset=false){if(!token){location.href='/vao-coi';return}const u=`${API}/feed?limit=15${!reset&&cursor?`&before=${cursor}`:''}`;const r=await fetch(u,{headers:headers()});const d=await r.json();if(!d.ok){$('feed-list').innerHTML=`<p class="state">${esc(d.error)}</p>`;return}if(reset)$('feed-list').innerHTML='';$('feed-list').insertAdjacentHTML('beforeend',d.items.length?d.items.map(card).join(''):'<p class="state">Chưa có lời nào. Bạn hãy gieo lời đầu tiên.</p>');cursor=d.nextCursor;$('feed-more').hidden=!cursor;bind()}
    function bind(){document.querySelectorAll('[data-like]').forEach(e=>e.addEventListener('click',async()=>{const id=Number((e as HTMLElement).dataset.like);const r=await fetch(`${API}/reaction/toggle`,{method:'POST',headers:{'Content-Type':'application/json',...headers()},body:JSON.stringify({postId:id})});const d=await r.json();if(d.ok){e.classList.toggle('on',d.active);e.querySelector('.action-count')!.textContent=d.count}}));document.querySelectorAll('[data-show]').forEach(e=>e.addEventListener('click',()=>replies(Number((e as HTMLElement).dataset.show))));document.querySelectorAll('[data-rf]').forEach(e=>e.addEventListener('submit',async(ev)=>{ev.preventDefault();const id=Number((e as HTMLElement).dataset.rf),i=e.querySelector('input') as HTMLInputElement;if(!i.value.trim())return;const r=await fetch(`${API}/reply/create`,{method:'POST',headers:{'Content-Type':'application/json',...headers()},body:JSON.stringify({postId:id,body:i.value})});const d=await r.json();if(d.ok){i.value='';replies(id)}}))}
    async function replies(id:number){const b=$(`rb-${id}`);b.hidden=false;const r=await fetch(`${API}/replies?postId=${id}`,{headers:headers()});const d=await r.json();b.innerHTML=d.ok&&d.items.length?d.items.map((x:any)=>`<p><b>${esc(x.author.phapdanh)}</b> ${esc(x.body)}</p>`).join(''):'<p>Chưa có lời ghé.</p>'}
    $('feed-compose').addEventListener('submit',async e=>{e.preventDefault();const body=($('feed-body') as HTMLTextAreaElement).value.trim();if(!body)return;const r=await fetch(`${API}/post/create`,{method:'POST',headers:{'Content-Type':'application/json',...headers()},body:JSON.stringify({body,visibility:($('feed-vis') as HTMLSelectElement).value})});const d=await r.json();$('feed-msg').textContent=d.ok?'Đã gieo lời':d.error||'Chưa gieo được';if(d.ok){($('feed-body') as HTMLTextAreaElement).value='';load(true)}});
    $('feed-more').addEventListener('click',()=>load());load(true);
  </script>
</BaseLayout>
