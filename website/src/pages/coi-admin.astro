---
import BaseLayout from '../layouts/BaseLayout.astro';
import { phamList } from '../data/phuocphieu';
const openPham = phamList.filter((p) => p.open);
const allPham = phamList;
---

<BaseLayout title="Cửa Quán Chiếu — Admin | Tần Số Nacha" description="Cổng quán chiếu tất cả các cõi.">
  <section class="ca-wrap">
    <!-- GATE -->
    <div id="ca-gate" class="ca-gate">
      <div class="ca-gate-card">
        <p class="font-brush text-bronze-light text-2xl tracking-[0.35em]">觀 照</p>
        <h1 class="font-display text-3xl text-parchment mt-2">Cửa Quán Chiếu</h1>
        <p class="text-parchment/60 text-sm mt-3 mb-6">Nhập chìa khoá tổng để soi khắp mọi cõi.</p>
        <div class="ca-form">
          <input id="ca-token" class="ca-input" type="password" placeholder="Chìa khoá tổng…" autocomplete="off" />
          <button id="ca-enter" class="ca-btn">Quán Chiếu </button>
       </div>
        <p id="ca-err" class="ca-err" hidden>Chìa khoá chưa đúng — xin thử lại.</p>
     </div>
   </div>

    <!-- DASHBOARD (ẩn tới khi đúng token) -->
    <div id="ca-board" class="ca-board" hidden>
      <div class="container-content max-w-4xl py-12">
        <div class="text-center mb-8">
          <span class="eyebrow text-bronze-light">觀 照 十 五 品</span>
          <h2 class="font-display text-3xl text-parchment mt-1">Toàn Cảnh Các Cõi</h2>
          <p class="text-parchment/55 text-sm mt-2">Bấm để bước vào bất kỳ cõi, phẩm, hay pháp hội nào.</p>
       </div>

        <!-- HÀNG CHỬ DUYỆT ĐÓNG GÓP -->
        <div class="ca-queue">
          <div class="ca-queue-head">
            <h3 class="ca-queue-title"> Hàng Chờ Duyệt Đóng Góp <span id="ca-q-count" class="ca-q-badge">0</span></h3>
            <button id="ca-q-refresh" class="ca-q-refresh">↻ Làm mới</button>
         </div>
          <div id="ca-q-list"><p class="text-parchment/50 text-sm">Nhập chìa khoá xong sẽ hiện hàng chờ.</p></div>
       </div>

        <div class="ca-grid">
          {allPham.map((p) => (
            <div class={`ca-cell ${p.open ? '' : 'ca-cell--soon'}`} style={`--accent:${p.hue.accent};--from:${p.hue.from};--to:${p.hue.to}`}>
              <div class="ca-cell-head">
                <span class="ca-cell-glyph">{p.glyph}</span>
                <div>
                  <p class="ca-cell-han">{p.han} · Phẩm {p.rank}</p>
                  <h3 class="ca-cell-name">{p.name}</h3>
               </div>
             </div>
              {p.open ? (
                <div class="ca-links">
                  <a href={`/phuoc-phieu/${p.slug}`}> Phẩm</a>
                  <a href={`/coi/${p.slug}`}> Cõi</a>
                  <a href={`/coi/${p.slug}/event`}> Pháp Hội</a>
               </div>
              ) : (
                <p class="ca-soon">Còn ẩn trong sương</p>
              )}
           </div>
          ))}
       </div>

        <div class="text-center mt-10">
          <a href="/phuoc-phieu" class="btn-secondary !text-parchment !border-parchment/40 text-sm">← Về trang Phước Phiếu</a>
       </div>
     </div>
   </div>
 </section>

  <style is:global>
    .ca-wrap { min-height: 100vh; margin-top: -4rem; background: linear-gradient(160deg, #2C2C2C, #1a1510); }
    .ca-gate { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
    .ca-gate-card { text-align: center; background: rgba(255,255,255,0.04); border: 1px solid rgba(201,169,110,0.3); border-radius: 1.2rem; padding: 2.2rem 1.8rem; max-width: 26rem; width: 100%; box-shadow: 0 24px 60px rgba(0,0,0,0.5); }
    .ca-form { display: flex; gap: 0.5rem; }
    .ca-input { flex: 1; background: rgba(255,255,255,0.07); border: 1px solid rgba(201,169,110,0.4); border-radius: 9999px; padding: 0.8rem 1.2rem; color: #F5F0EB; text-align: center; }
    .ca-input:focus { outline: none; border-color: #C9A96E; }
    .ca-btn { border-radius: 9999px; padding: 0.8rem 1.3rem; font-weight: 600; background: #C9A96E; color: #1c1710; white-space: nowrap; transition: filter .2s; }
    .ca-btn:hover { filter: brightness(1.08); }
    .ca-err { color: #d98a8a; font-size: 0.8rem; margin-top: 0.8rem; }
    .ca-board { padding-top: 4rem; }
    .ca-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.8rem; }
    .ca-cell { background: linear-gradient(140deg, var(--from), var(--to)); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 1rem; padding: 1rem; }
    .ca-cell--soon { opacity: 0.5; filter: grayscale(0.4); }
    .ca-cell-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.7rem; }
    .ca-cell-glyph { font-size: 1.6rem; }
    .ca-cell-han { font-family: 'Noto Serif SC', serif; font-size: 0.68rem; color: var(--accent); }
    .ca-cell-name { font-family: 'Playfair Display', serif; font-size: 1.05rem; color: #F5F0EB; font-weight: 600; }
    .ca-links { display: flex; flex-direction: column; gap: 0.35rem; }
    .ca-links a { font-size: 0.82rem; color: #F5F0EB; background: color-mix(in srgb, var(--accent) 14%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent); border-radius: 0.5rem; padding: 0.4rem 0.6rem; transition: background .2s; }
    .ca-links a:hover { background: color-mix(in srgb, var(--accent) 28%, transparent); }
    .ca-soon { font-size: 0.75rem; color: rgba(245,240,235,0.5); font-style: italic; }
    .ca-queue { background: rgba(255,255,255,0.04); border: 1px solid rgba(201,169,110,0.28); border-radius: 1rem; padding: 1.1rem 1.2rem; margin-bottom: 1.6rem; }
    .ca-queue-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.9rem; }
    .ca-queue-title { font-family: 'Playfair Display', serif; color: #F5F0EB; font-size: 1.05rem; display: flex; align-items: center; gap: 0.5rem; }
    .ca-q-badge { background: #C9A96E; color: #1c1710; font-size: 0.72rem; padding: 1px 9px; border-radius: 999px; }
    .ca-q-refresh { font-size: 0.78rem; color: #C9A96E; text-decoration: underline; }
    .ca-q-item { border: 1px solid rgba(201,169,110,0.2); border-radius: 0.8rem; padding: 0.9rem 1rem; margin-bottom: 0.7rem; background: rgba(0,0,0,0.15); }
    .ca-q-top { display: flex; justify-content: space-between; gap: 0.6rem; }
    .ca-q-t { color: #F5F0EB; font-weight: 600; font-size: 0.92rem; }
    .ca-q-meta { font-size: 0.72rem; color: rgba(245,240,235,0.55); margin-top: 2px; }
    .ca-q-flag { font-size: 0.68rem; padding: 2px 8px; border-radius: 999px; background: rgba(180,150,80,0.25); color: #e6c98a; white-space: nowrap; height: fit-content; }
    .ca-q-body { font-size: 0.82rem; color: rgba(245,240,235,0.7); margin: 0.5rem 0; line-height: 1.5; }
    .ca-q-link { font-size: 0.76rem; color: #C9A96E; text-decoration: underline; word-break: break-all; }
    .ca-q-embed { margin: 0.6rem 0; border-radius: 0.6rem; overflow: hidden; }
    .ca-q-embed iframe { width: 100%; aspect-ratio: 16/9; border: 0; }
    .ca-q-acts { display: flex; gap: 0.5rem; margin-top: 0.6rem; }
    .ca-q-ok { flex: 1; border-radius: 9999px; padding: 0.5rem; background: #5d8a6e; color: #fff; font-weight: 600; font-size: 0.82rem; }
    .ca-q-no { flex: 1; border-radius: 9999px; padding: 0.5rem; background: rgba(139,26,47,0.6); color: #fff; font-weight: 600; font-size: 0.82rem; }
 </style>

  <script>
    // Token admin quán chiếu (client-side gate — đủ cho việc anh Nấng xem)
    const ADMIN = 'ChauNacha';
    const gate = document.getElementById('ca-gate');
    const board = document.getElementById('ca-board');
    const inp = document.getElementById('ca-token') as HTMLInputElement | null;
    const btn = document.getElementById('ca-enter');
    const err = document.getElementById('ca-err');

    let ADMIN_KEY = '';
    function open() {
      if (gate) gate.style.display = 'none';
      if (board) board.hidden = false;
      try { sessionStorage.setItem('ca-ok', '1'); if (ADMIN_KEY) sessionStorage.setItem('ca-key', ADMIN_KEY); } catch {}
      loadQueue();
    }

    // ── HÀNG CHỬ DUYỆT ──
    const API = '/pp-api';
    function esc(s){ return String(s||'').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    const TLABEL = { track:' Nhạc', video:' Video', podcast:' Podcast', post:' Chuyện' };
    async function loadQueue() {
      const key = ADMIN_KEY || (()=>{ try{return sessionStorage.getItem('ca-key')||'';}catch{return '';} })();
      const box = document.getElementById('ca-q-list'); if (!box) return;
      try {
        const r = await fetch(`${API}/admin/queue`, { headers: { 'X-Admin-Token': key } });
        const d = await r.json();
        const cnt = document.getElementById('ca-q-count'); if (cnt) cnt.textContent = String((d.items||[]).length);
        if (!d.ok || !d.items.length) { box.innerHTML = '<p class="text-parchment/50 text-sm">Không có bài nào chờ duyệt </p>'; return; }
        box.innerHTML = d.items.map((it) => {
          const embed = it.embed_url ? `<div class="ca-q-embed"><iframe src="${esc(it.embed_url)}" allow="encrypted-media" loading="lazy"></iframe></div>` : (it.media_url ? `<a class="ca-q-link" href="${esc(it.media_url)}" target="_blank">${esc(it.media_url)}</a>` : '');
          const flag = it.status === 'flagged' ? `<span class="ca-q-flag">AI: ${esc(it.ai_verdict||'?')}</span>` : '';
          return `<div class="ca-q-item" data-id="${it.id}">
            <div class="ca-q-top"><div><p class="ca-q-t">${esc(it.title)}</p><p class="ca-q-meta">${TLABEL[it.ctype]||it.ctype} · ${esc(it.phapdanh)} · +${it.phuoc_reward} Phước</p></div>${flag}</div>
            ${it.body ? `<p class="ca-q-body">${esc(it.body)}</p>` : ''}
            ${embed}
            ${it.ai_note ? `<p class="ca-q-meta">Thủ Các AI: ${esc(it.ai_note)}</p>` : ''}
            <div class="ca-q-acts"><button class="ca-q-ok" data-act="approve">Duyệt</button><button class="ca-q-no" data-act="reject">Từ chối</button></div>
         </div>`;
        }).join('');
        box.querySelectorAll('.ca-q-item').forEach((el) => {
          const id = el.getAttribute('data-id');
          el.querySelector('.ca-q-ok')?.addEventListener('click', () => review(id, 'approve', el));
          el.querySelector('.ca-q-no')?.addEventListener('click', () => review(id, 'reject', el));
        });
      } catch { box.innerHTML = '<p class="text-parchment/50 text-sm">Không tải được hàng chờ.</p>'; }
    }
    async function review(id, action, el) {
      const key = ADMIN_KEY || (()=>{ try{return sessionStorage.getItem('ca-key')||'';}catch{return '';} })();
      let reason = '';
      if (action === 'reject') { reason = prompt('Lý do từ chối (user sẽ nhận qua hộp thư):') || 'Chưa phù hợp tinh thần Tần Số Nacha'; }
      try {
        const r = await fetch(`${API}/admin/review`, { method:'POST', headers:{'Content-Type':'application/json','X-Admin-Token':key}, body: JSON.stringify({ id: parseInt(id,10), action, reason }) });
        const d = await r.json();
        if (d.ok) { (el as HTMLElement).style.opacity = '0.4'; setTimeout(loadQueue, 500); }
      } catch {}
    }
    document.getElementById('ca-q-refresh')?.addEventListener('click', loadQueue);
    function tryEnter() {
      if ((inp?.value || '') === ADMIN) { ADMIN_KEY = inp?.value || ''; open(); }
      else if (err) { err.hidden = false; }
    }
    btn?.addEventListener('click', tryEnter);
    inp?.addEventListener('keydown', (e) => { if (e.key === 'Enter') tryEnter(); });
    // nhớ trong phiên
    try { if (sessionStorage.getItem('ca-ok') === '1') open(); } catch {}
 </script>
</BaseLayout>
