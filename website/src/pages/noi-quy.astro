---
import BaseLayout from '../layouts/BaseLayout.astro';

const dieuKhoan = [
  { h: '1. Bạn tự chịu trách nhiệm về nội dung mình đăng',
    p: 'Mọi bài nhạc, pháp âm, video, podcast hay câu chuyện bạn đăng lên Tần Số Nacha là do bạn tự nguyện đóng góp. Bạn — không phải Tần Số Nacha — chịu trách nhiệm hoàn toàn về nội dung đó, bao gồm tính hợp pháp, tính chính xác và mọi hệ quả phát sinh.' },
  { h: '2. Bạn cam kết có quyền chia sẻ',
    p: 'Khi đăng, bạn xác nhận mình là chủ sở hữu hoặc có đầy đủ quyền hợp pháp để chia sẻ nội dung đó (tự sáng tác, được cho phép, thuộc phạm vi công cộng, hoặc giấy phép cho phép chia sẻ). Bạn không đăng nội dung vi phạm bản quyền của người khác.' },
  { h: '3. Bạn cấp phép hiển thị cho Tần Số Nacha',
    p: 'Khi đăng, bạn cho phép Tần Số Nacha lưu trữ, hiển thị, nhúng và phát nội dung của bạn trên nền tảng cho cộng đồng cùng thưởng thức. Bạn vẫn giữ quyền sở hữu của mình; có thể yêu cầu gỡ bài bất cứ lúc nào.' },
  { h: '4. Nội dung phải thuận tinh thần thiện lành',
    p: 'Tần Số Nacha là không gian tu tập, tĩnh tâm, hướng thiện. Nội dung nên xoay quanh Phật pháp, thiền, chữa lành, tử tế, an lạc — hoặc ít nhất không đi ngược tinh thần ấy.' },
  { h: '5. Nội dung bị cấm',
    p: 'Không đăng: nội dung khiêu dâm/phản cảm; bạo lực, thù hận, kỳ thị; lừa đảo, cờ bạc, quảng cáo trá hình, spam; chính trị kích động; cổ xuý mê tín dị đoan có hại; hàng cấm; hoặc bất kỳ nội dung vi phạm pháp luật Việt Nam.' },
  { h: '6. Mọi bài đều qua kiểm duyệt',
    p: 'Bài bạn đăng sẽ ở trạng thái "chờ duyệt". Hệ thống dùng lọc từ khoá + AI đánh giá, kết hợp Thủ Các xem tay, trước khi hiển thị công khai. Được duyệt bạn mới nhận điểm Phước; bị từ chối sẽ không cộng điểm.' },
  { h: '7. Điểm Phước không phải tiền',
    p: 'Điểm Phước là ghi nhận sự đóng góp và tu tập, mang tính tinh thần. Không phải tiền tệ, không quy đổi ra tiền mặt, không phải chứng khoán hay đầu tư. Gian dối để farm điểm sẽ bị thu hồi và có thể mất quyền đóng góp.' },
  { h: '8. Quyền của Thủ Các',
    p: 'Tần Số Nacha có quyền từ chối, ẩn, hoặc gỡ bất kỳ nội dung nào không phù hợp, kể cả sau khi đã duyệt, mà không cần báo trước. Việc này nhằm giữ không gian trong lành cho cộng đồng.' },
  { h: '9. Báo cáo & gỡ nội dung',
    p: 'Nếu bạn thấy nội dung vi phạm hoặc muốn gỡ bài của mình, hãy báo với Thủ Các. Chúng tôi tôn trọng quyền tác giả và sẽ xử lý các khiếu nại bản quyền hợp lệ.' },
  { h: '10. Thay đổi điều khoản',
    p: 'Nội quy có thể được cập nhật theo thời gian để giữ Tần Số Nacha lành mạnh. Việc tiếp tục đóng góp đồng nghĩa bạn chấp nhận bản nội quy mới nhất.' },
];
---

<BaseLayout title="Nội Quy & Điều Khoản — Tần Số Nacha" description="Nội quy cộng đồng và điều khoản đóng góp nội dung tại Tần Số Nacha.">
  <section class="section-padding bg-parchment">
    <div class="container-content max-w-2xl">
      <div class="text-center mb-10">
        <span class="font-brush text-2xl tracking-[0.35em] text-bronze-dark">規 約</span>
        <h1 class="font-display text-3xl md:text-4xl text-ink mt-2">Nội Quy &amp; Điều Khoản Đóng Góp</h1>
        <p class="text-ink/60 text-sm mt-3">Xin đọc kỹ trước khi góp một viên gạch cho Tần Số Nacha </p>
     </div>

      <div class="nq-intro">
        Tần Số Nacha là không gian để mọi người cùng chia sẻ pháp nhạc, tụng kinh, thiền ca, podcast
        và những câu chuyện tử tế. Để giữ nơi đây trong lành, khi đóng góp bạn đồng ý các điều sau.
     </div>

      {dieuKhoan.map((d) => (
        <div class="nq-item">
          <h2 class="nq-h">{d.h}</h2>
          <p class="nq-p">{d.p}</p>
       </div>
      ))}

      <div class="nq-foot">
        <p>Bằng việc tích chọn "Tôi đồng ý" khi đăng, bạn xác nhận đã đọc, hiểu và chấp nhận toàn bộ nội quy này,
        đồng thời tự chịu trách nhiệm về nội dung mình đóng góp.</p>
        <a href="/dong-gop" class="nq-back">← Về trang Đóng Góp</a>
     </div>
   </div>
 </section>

  <style is:global>
    .nq-intro { background: rgba(201,169,110,0.1); border-left: 4px solid #C9A96E; border-radius: 0 0.8rem 0.8rem 0; padding: 1rem 1.2rem; font-size: 0.92rem; color: #4a4030; line-height: 1.7; margin-bottom: 1.6rem; }
    .nq-item { border-bottom: 1px solid rgba(201,169,110,0.2); padding: 1.1rem 0; }
    .nq-h { font-family: 'Playfair Display', serif; font-size: 1.05rem; color: #8B6F2E; font-weight: 600; margin-bottom: 0.4rem; }
    .nq-p { font-size: 0.9rem; color: #3a3428; line-height: 1.7; }
    .nq-foot { margin-top: 1.8rem; background: rgba(44,44,44,0.04); border-radius: 1rem; padding: 1.2rem 1.4rem; font-size: 0.85rem; color: #4a4030; line-height: 1.7; }
    .nq-back { display: inline-block; margin-top: 1rem; color: #8B6F2E; text-decoration: underline; font-weight: 600; }
 </style>
</BaseLayout>
