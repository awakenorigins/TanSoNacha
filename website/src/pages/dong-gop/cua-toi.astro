---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Duyên Tôi Đã Cộng — Tần Số Nacha" description="Những duyên bạn đã cộng tới Tần Số Nacha.">
  <section class="section-padding" style="background:#1a1510;min-height:100vh;margin-top:-4rem;padding-top:6rem">
    <div class="container-content max-w-2xl">
      <div class="text-center mb-8">
        <span class="font-brush text-2xl tracking-[0.35em]" style="color:#C9A96E">吾 獻</span>
        <h1 class="font-display text-3xl text-parchment mt-2">Duyên Tôi Đã Cộng</h1>
        <a href="/dong-gop" class="ct-add">+ Cộng duyên mới</a>
     </div>
      <div id="ct-list"><p class="text-center text-parchment/50 text-sm">Đang tải…</p></div>
   </div>
 </section>

  <style is:global>
    .ct-add { display:inline-block; margin-top:0.8rem; border-radius:9999px; padding:0.45rem 1.2rem; background:#C9A96E; color:#1c1710; font-weight:600; font-size:0.82rem; }
    .ct-row { display:flex; align-items:center; gap:0.7rem; background:rgba(255,255,255,0.04); border:1px solid rgba(201,169,110,0.22); border-radius:0.9rem; padding:0.9rem 1.1rem; margin-bottom:0.7rem; }
    .ct-row .t { flex:1; min-width:0; }
    .ct-row .title { color:#F5F0EB; font-size:0.92rem; font-weight:600; }
    .ct-row .meta { font-size:0.7rem; color:rgba(245,240,235,0.5); }
    .ct-status { font-size:0.7rem; padding:3px 10px; border-radius:999px; white-space:nowrap; }
    .st-pending { background:rgba(201,169,110,0.16); color:#C9A96E; }
    .st-approved { background:rgba(93,138,110,0.2); color:#8fd0a8; }
    .st-rejected { background:rgba(139,26,47,0.2); color:#e09aa5; }
    .st-flagged { background:rgba(180,150,80,0.2); color:#d4b47c; }
 </style>

  <script>
    const API = '/pp-api';
    function esc(s: string): string { return String(s||'').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string)); }
    const TYPE: Record<string,string> = { track:'', video:'', podcast:'', post:'' };
    const STLABEL: Record<string,string> = { pending:'Đang soi', approved:'Đã khai mở', rejected:'Cần chỉnh', flagged:'Đang xét' };

    async function load() {
      let token = '';
      try { token = localStorage.getItem('pp-token') || ''; } catch {}
      const box = document.getElementById('ct-list');
      if (!box) return;
      if (!token) { box.innerHTML = '<p class="text-center text-parchment/60 text-sm">Xin <a href="/vao-coi" style="color:#C9A96E;text-decoration:underline">vào cõi</a> để xem bài của bạn.</p>'; return; }
      try {
        const r = await fetch(`${API}/my-contributions?token=${encodeURIComponent(token)}`);
        const d = await r.json();
        if (!d.ok || !d.items || !d.items.length) { box.innerHTML = '<p class="text-center text-parchment/50 text-sm">Bạn chưa cộng duyên nào. <a href="/dong-gop" style="color:#C9A96E;text-decoration:underline">Cộng ngay</a> </p>'; return; }
        box.innerHTML = d.items.map((it: any) => `
          <div class="ct-row">
            <span style="font-size:1.3rem">${TYPE[it.ctype]||''}</span>
            <div class="t"><p class="title">${esc(it.title)}</p><p class="meta">${it.platform||''} · ${it.status==='approved'?('+'+it.phuoc_reward+' Phước'):''}</p></div>
            <span class="ct-status st-${it.status}">${STLABEL[it.status]||it.status}</span>
         </div>`).join('');
      } catch { box.innerHTML = '<p class="text-center text-parchment/50 text-sm">Không tải được.</p>'; }
    }
    load();
 </script>
</BaseLayout>
